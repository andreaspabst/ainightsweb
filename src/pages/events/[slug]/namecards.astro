---
// Interner Kurzlink für Türsteher/Crew: <event-page-url>/namecards/ leitet
// direkt auf die druckfertige Namenskarten-PDF weiter (aus
// public/media/namenskarten/<slug>.pdf, erzeugt vom event-namecards-Skill).
// Bewusst NIRGENDWO verlinkt, NICHT in der Sitemap (astro.config.mjs
// filtert die Route raus) und per robots.txt gesperrt — nur wer die URL
// kennt, kommt hier hin.
import { getCollection } from 'astro:content';
import { latestNamecardsFile } from '../../../lib/namecards.mjs';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events
    .filter((e) => latestNamecardsFile(e.data.slug))
    .map((e) => ({ params: { slug: e.data.slug } }));
}

const { slug } = Astro.params;
const target = `/media/namenskarten/${latestNamecardsFile(slug)}`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Namenskarten</title>
  </head>
  <body>
    <p>Weiterleitung … <a href={target}>hier klicken</a>, falls das nicht automatisch passiert.</p>
  </body>
</html>
