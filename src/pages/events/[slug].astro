---
import { getCollection } from 'astro:content';
import AiNightsEventLayout from '../../components/events/AiNightsEventLayout.astro';
import WomanNightsEventLayout from '../../components/events/WomanNightsEventLayout.astro';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((e) => ({ params: { slug: e.data.slug }, props: { e } }));
}

const { e } = Astro.props;
// AI Woman Nights bekommt ein eigenständiges Design, erkannt am Slug-Präfix
// (kein zusätzliches Schema-Feld nötig) — gleiche Route, gleiche URL.
const isWomanNights = e.data.slug.startsWith('ai-woman-nights');
---

{isWomanNights ? <WomanNightsEventLayout e={e} /> : <AiNightsEventLayout e={e} />}
