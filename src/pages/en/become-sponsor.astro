---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { imgVariant } from '../../lib/images';

const CALL_URL = 'https://tidycal.com/andreaspabstcom/ainights';

const stats = [
  { value: '110', label: 'Avg. attendees per afterwork' },
  { value: '100k', label: 'Content reach' },
  { value: '100%', label: 'AI focus every night' },
  { value: '4', label: 'Cities planned' },
];

const audience = [
  'C-Level & Management',
  'Startup Founders',
  'Project Leads',
  'IT Decision-Makers',
  'Marketing Decision-Makers',
  'HR Leaders',
];

const benefits = [
  {
    title: 'Premium marketing materials',
    text: 'Roll-up displays on site, logo projections, prominent placement on the website and all promotional materials.',
  },
  {
    title: 'Branded fabric lanyards',
    text: 'With our largest sponsoring package: every attendee wears your branding all night long.',
  },
  {
    title: 'Tailored to you',
    text: 'We build the perfect sponsoring concept for your company based on your needs.',
  },
  {
    title: 'Full flexibility',
    text: 'From a stand to flyers, talks, branding to social media — anything is possible!',
  },
  {
    title: 'Social media presence',
    text: 'Your logo across all social channels, the website and all promotional materials.',
  },
  {
    title: 'Digital goodie bag',
    text: 'Sent by email to every attendee — your product or offer straight into their inbox.',
  },
  {
    title: 'Product integration',
    text: 'We\'re happy to build your product into the evening — as a showcase, demo or interactive session.',
  },
  {
    title: 'Content for you',
    text: 'On request, we create social media content streamlined for your product/company.',
  },
];

const reasons = [
  {
    title: 'Direct access to decision-makers',
    text: 'Middle management and C-level attend regularly. Build valuable connections in a relaxed atmosphere.',
  },
  {
    title: 'Community, not a one-off event',
    text: 'AI moves too fast for a single event. Become part of a growing community with regular touchpoints.',
  },
  {
    title: 'Standing out with 100% AI focus',
    text: 'Underline your relevance and show: AI matters to us. Sponsoring AI Nights puts your brand in the AI spotlight.',
  },
  {
    title: 'Plenty of other benefits',
    text: 'From social media to digital goodie bags to tailored product integrations — we\'ll find the perfect package for you.',
  },
];

// Impressionen (aus dem WordPress-Original übernommen)
const impressions = [
  '1-128', '1-106', '1-107', '1-36', '1-112', '1-34-publikum', '1-8', '1-113',
  '1-9', '1-22', '1-20', '1-111', '1-105', '1-104', '1-110', '1-21',
].map((n) => `/wp-content/uploads/2026/01/${n}.jpg`);

const community = [
  '1-62', '1-73', '1-74', '1-60', '1-89', '1-76', '1-63', '1-77',
  '1-88', '1-98', '1-67', '1-66', '1-72', '1-99', '1-29', '1-58',
].map((n) => `/wp-content/uploads/2026/01/${n}.jpg`);
---

<Layout
  lang="en"
  title="Become a Sponsor - AI Nights"
  description="Become a sponsor of AI Nights: reach decision-makers, IT professionals and the AI community at our afterwork events in Nuremberg and Munich. Flexible packages for every need."
  path="/en/become-sponsor/"
  alternates={{ de: '/de/sponsoring/', en: '/en/become-sponsor/' }}
>
  <Header lang="en" />
  <main>
    <section class="hero section">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Afterwork Events &amp; Meetups</p>
          <h1 class="display-font">Become Part of the AI&#8209;Revolution</h1>
          <p class="sub">
            Join first-class meetups all about AI. Engaging, entertaining and educational talks await you!
            Connect with experts, learn from industry leaders and discover the future of artificial intelligence.
          </p>
          <div class="hero-actions">
            <a href={CALL_URL} target="_blank" rel="noopener" class="btn btn-primary">Free intro call</a>
            <a href="/downloads/ai-nights-sponsoring-pitchdeck.pdf" download class="btn btn-ghost">Pitch deck [PDF]</a>
            <a href="#kontakt" class="btn btn-ghost">Become a sponsor</a>
          </div>
        </div>
        <figure class="hero-media card">
          <img src={imgVariant('/wp-content/uploads/2026/01/1-34-publikum.jpg', 1024)} alt="Audience at AI Nights Nuremberg" loading="eager" width="800" height="533" />
          <figcaption>
            <h2 class="display-font">AI enthusiasts</h2>
            <p>
              Reach project leads, IT decision-makers, C-level, startup founders, marketing and HR leaders in one
              evening. Position your company as an innovation leader in the AI community.
            </p>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <dl class="stats">
          {stats.map((s) => (
            <div class="stat card">
              <dt>{s.label}</dt>
              <dd class="display-font">{s.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section">
      <div class="container narrow">
        <h2 class="display-font">What is AI Nights?</h2>
        <div class="prose-like">
          <p>
            <strong>AI Nights</strong> is the event series for everyone who wants to not just understand AI, but
            <strong>actively use it</strong>. Launched <strong>in 2025 in Nuremberg</strong>, we bring together
            <strong>developers, engineers, lawyers, students, marketing and HR professionals</strong> — anyone with
            technical curiosity who wants to help shape the future.
          </p>
          <p>
            Our events are <strong>100% AI-focused</strong>: showcases, hands-on demos, interactive sessions. No
            boring lectures, just a <strong>relaxed afterwork atmosphere</strong> with
            <strong>free drinks and snacks</strong>.
          </p>
          <p>
            What makes us different: <strong>AI moves too fast for just a single event</strong>. That's why we bet on
            <strong>community</strong> — regular meetups where people exchange ideas, connect and learn together.
          </p>
          <p>
            Our <strong>premiere was already a full success: over 50 tickets sold!</strong> With
            <strong>top speakers from different industries, companies and countries</strong> we deliver
            high-caliber content for <strong>middle management and C-level</strong>.
          </p>
          <p>
            We're planning <strong>workshops, sessions and hackathons</strong> — and we want to
            <strong>bring companies with valuable products on board</strong> who share our vision:
            <strong>bringing people together</strong> and shaping the AI revolution together.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container center-head">
        <h2 class="display-font">Impressions from our events</h2>
        <div class="gallery">
          {impressions.map((src) => (
            <img src={imgVariant(src, 640)} alt="AI Nights impressions" loading="lazy" width="400" height="284" />
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container center-head">
        <h2 class="display-font">Your audience is waiting</h2>
        <p class="sub center">Our events attract decision-makers from every industry — all with technical curiosity and a drive to innovate.</p>
        <ul class="chips">
          {audience.map((a) => (
            <li>{a}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="container center-head">
        <h2 class="display-font">Your benefits as a sponsor</h2>
        <p class="sub center">Maximum visibility and flexible packages for every need</p>
        <div class="grid four">
          {benefits.map((b) => (
            <article class="card topic">
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </article>
          ))}
        </div>
        <a href="/downloads/ai-nights-sponsoring-pitchdeck.pdf" download class="btn btn-primary big-cta">Download sponsoring pitch deck [PDF, 9&nbsp;MB]</a>
      </div>
    </section>

    <section class="section">
      <div class="container center-head">
        <h2 class="display-font">The AI Nights community</h2>
        <div class="gallery">
          {community.map((src) => (
            <img src={imgVariant(src, 640)} alt="The AI Nights community" loading="lazy" width="400" height="284" />
          ))}
        </div>
        <a href="/en/gallery/" class="btn btn-ghost">See the full gallery</a>
      </div>
    </section>

    <section class="section">
      <div class="container center-head">
        <h2 class="display-font">Why sponsor AI Nights?</h2>
        <div class="grid two reasons">
          {reasons.map((r) => (
            <article class="card reason">
              <span class="check">✓</span>
              <div>
                <h3>{r.title}</h3>
                <p>{r.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container center-head">
        <p class="eyebrow">This is what AI Nights feels like</p>
        <h2 class="display-font">An evening at AI Nights</h2>
        <div class="video card">
          <iframe
            src="https://www.youtube.com/embed/U-F1GZmbzJE"
            title="An evening at AI Nights"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <section id="kontakt" class="section cta-section">
      <div class="container center-head">
        <p class="eyebrow">The perfect package for you</p>
        <h2 class="display-font">Ready to become part of AI Nights?</h2>
        <p class="sub center">Let's build the perfect sponsoring concept for your company together.</p>
        <div class="cta-actions">
          <a href={CALL_URL} target="_blank" rel="noopener" class="btn btn-primary">Free intro call →</a>
        </div>
        <p class="cta-note">In the intro call you'll also get our current sponsoring pitch deck as a PDF.</p>
      </div>
    </section>
  </main>
  <Footer lang="en" />
</Layout>

<style>
  .hero {
    padding-block: 4rem 2.5rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin: 0.4rem 0 1rem;
  }
  .sub {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 60ch;
  }
  .hero-copy .sub {
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .hero-media {
    overflow: hidden;
  }
  .hero-media img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }
  .hero-media figcaption {
    padding: 1.4rem 1.5rem 1.6rem;
  }
  .hero-media h2 {
    font-size: 1.3rem;
    margin-bottom: 0.6rem;
  }
  .hero-media p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .section {
    padding-block: 2.5rem;
  }
  .center-head {
    text-align: center;
  }
  .center-head h2,
  .narrow h2 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    margin: 0.4rem 0 1.2rem;
  }
  .sub.center {
    margin: 0 auto 2.2rem;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.2rem;
    margin: 0;
  }
  .stat {
    padding: 1.6rem 1.4rem;
    text-align: center;
    display: flex;
    flex-direction: column-reverse;
    gap: 0.4rem;
  }
  .stat dd {
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 700;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin: 0;
  }
  .stat dt {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  .narrow {
    max-width: 780px;
  }
  .prose-like p {
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 1.1rem;
  }
  .prose-like strong {
    color: var(--text-primary);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.9rem;
    margin-bottom: 1.8rem;
  }
  .gallery img {
    width: 100%;
    aspect-ratio: 400 / 284;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid var(--border-strong);
    display: block;
  }
  .chips {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
  }
  .chips li {
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 0.55rem 1.2rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .grid {
    display: grid;
    gap: 1.5rem;
    text-align: left;
  }
  .grid.four {
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
  .grid.two {
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    max-width: 900px;
    margin-inline: auto;
  }
  .topic {
    padding: 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .topic h3,
  .reason h3 {
    font-size: 1.1rem;
  }
  .topic p,
  .reason p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .big-cta {
    margin-top: 2.2rem;
  }
  .reasons {
    margin-top: 0.5rem;
  }
  .reason {
    padding: 1.4rem 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .reason .check {
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--gradient-accent);
    color: #fff;
    font-weight: 700;
  }
  .reason h3 {
    margin-bottom: 0.4rem;
  }
  .video {
    overflow: hidden;
    max-width: 860px;
    margin-inline: auto;
  }
  .video iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    display: block;
  }
  .cta-section {
    padding-bottom: 4.5rem;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .cta-note {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
