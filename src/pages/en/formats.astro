---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const formats = [
  {
    title: 'AI Nights Afterwork',
    desc: 'Our core format: five afterwork evenings a year with short talks, live demos and plenty of room to connect — live, after work.',
    href: '/de/tickets/',
    cta: 'See the events',
  },
  {
    title: 'AI Women’s Night',
    desc: 'The new format by and for women in the AI community — exchange, role models and hands-on learning at eye level.',
    soon: 'More details coming soon',
  },
];
---

<Layout
  lang="en"
  title="Formats — AI Nights"
  description="The AI Nights formats: regular afterwork evenings about Artificial Intelligence in Nuremberg and Munich — talks, live demos and community."
  path="/en/formats/"
  alternates={{ de: '/de/formate/', en: '/en/formats/' }}
>
  <Header lang="en" />
  <main class="container section">
    <div class="head">
      <p class="eyebrow">One format. One idea.</p>
      <h1 class="display-font">Our Formats</h1>
      <p class="sub">Making sense of AI together — live, approachable and hands-on over a relaxed afterwork.</p>
    </div>
    <div class="grid">
      {formats.map((f) => (
        <div class="card fmt">
          <h2 class="display-font">{f.title}</h2>
          <p>{f.desc}</p>
          {f.href ? <a href={f.href} class="btn btn-ghost">{f.cta}</a> : <span class="soon">{f.soon}</span>}
        </div>
      ))}
    </div>
  </main>
  <Footer lang="en" />
</Layout>

<style>
  .head {
    text-align: center;
    margin-bottom: 3rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin: 0.4rem 0 0.6rem;
  }
  .sub {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 56ch;
    margin-inline: auto;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .fmt {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .fmt h2 {
    font-size: 1.4rem;
  }
  .fmt p {
    color: var(--text-secondary);
    flex: 1;
  }
  .soon {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px dashed var(--border-strong);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
