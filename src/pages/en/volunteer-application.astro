---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { imgVariant } from '../../lib/images';

const FORM_URL = 'https://airtable.com/embed/appiiUytKG0IcB1Gn/pagwZn8nOT2VxiHrQ/form';

const benefits = [
  {
    img: '/wp-content/uploads/2026/04/AI-Nights-Nuernberg-03-168.jpg',
    alt: 'AI Nights Nuremberg',
    title: 'Experience events',
    text: 'Events are your big passion? Join us at the AI Nights events!',
  },
  {
    img: '/wp-content/uploads/2026/04/AI-Nights-Nuernberg-03-154.jpg',
    alt: 'AI Nights Nuremberg',
    title: 'Food & drinks for you',
    text: 'On the day of the event, you get food & drinks on the house! As a helping hand / volunteer you get special access.',
  },
  {
    img: '/wp-content/uploads/2026/01/28-ianight-28-scaled.jpg',
    alt: 'AI Nights Nuremberg',
    title: 'Connect',
    text: 'Experience the event from the other side for once! Our speakers are already looking forward to meeting you!',
  },
];
---

<Layout
  lang="en"
  title="Volunteer Application - AI Nights"
  description="Become a volunteer at AI Nights events: look behind the scenes, help with marketing, tech and check-in — and enjoy food & drinks on the house. Apply now!"
  path="/en/volunteer-application/"
  alternates={{ de: '/de/volunteer-bewerbung/', en: '/en/volunteer-application/' }}
>
  <Header lang="en" />
  <main>
    <section class="hero section">
      <div class="container">
        <p class="eyebrow">Become a volunteer</p>
        <h1 class="display-font">Join us at the AI&nbsp;Nights events</h1>
        <p class="sub">
          There's always plenty of great things to do and learn at our events!
          <strong>And, of course, the networking above all!</strong>
        </p>
        <h2 class="display-font sub-head">Event volunteers</h2>
        <p class="sub">Help out with marketing, event tech, check-in, show tech, stage tech, equipment or the setup!</p>
        <a href="#signup-form" class="btn btn-primary">Apply now</a>
      </div>
    </section>

    <section class="section">
      <div class="container center-head">
        <p class="eyebrow">Why become a volunteer?</p>
        <h2 class="display-font">Benefits for volunteers</h2>
        <p class="sub center">
          If you've always wanted to be part of regular, larger events and get a look behind the scenes,
          now's the perfect moment for you!
        </p>
        <div class="grid three">
          {benefits.map((b) => (
            <article class="card benefit">
              <img src={imgVariant(b.img, 640)} alt={b.alt} loading="lazy" width="640" height="427" />
              <div class="body">
                <h3>{b.title}</h3>
                <p>{b.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="signup-form" class="section form-section">
      <div class="container center-head">
        <p class="eyebrow">Apply now</p>
        <h2 class="display-font">Ready to experience the event differently?</h2>
        <p class="sub center">Just fill out the form and we'll get back to you!</p>
        <div class="form-embed card">
          <iframe src={FORM_URL} title="Volunteer application form" loading="lazy"></iframe>
        </div>
        <a href={FORM_URL} target="_blank" rel="noopener" class="btn btn-ghost">Open in a new tab</a>
      </div>
    </section>
  </main>
  <Footer lang="en" />
</Layout>

<style>
  .hero {
    text-align: center;
    padding-block: 4rem 2.5rem;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin: 0.4rem 0 1rem;
  }
  .sub {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 60ch;
    margin-inline: auto;
  }
  .sub strong {
    color: var(--text-primary);
  }
  .sub-head {
    font-size: 1.3rem;
    margin: 2rem 0 0.5rem;
  }
  .hero .btn {
    margin-top: 2rem;
  }
  .section {
    padding-block: 2.5rem;
  }
  .center-head {
    text-align: center;
  }
  .center-head h2 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    margin: 0.4rem 0 0.8rem;
  }
  .sub.center {
    margin: 0 auto 2.2rem;
  }
  .grid.three {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    text-align: left;
  }
  .benefit {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .benefit img {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    display: block;
  }
  .benefit .body {
    padding: 1.2rem 1.3rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .benefit h3 {
    font-size: 1.1rem;
  }
  .benefit p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .form-section {
    padding-bottom: 4.5rem;
  }
  .form-embed {
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .form-embed iframe {
    width: 100%;
    height: 900px;
    border: 0;
    display: block;
    background: transparent;
  }
</style>
