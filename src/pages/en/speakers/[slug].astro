---
// Englisches Speaker-Profil — gleiche Komponente wie /speaker/<slug>/.
// Der redaktionelle Teil kommt aus dem `en`-Block der Speaker-Datei.
import { getCollection } from 'astro:content';
import { isPlaceholderSpeaker } from '../../../lib/speakers';
import SpeakerPage from '../../../components/pages/SpeakerPage.astro';

export async function getStaticPaths() {
  const speakers = await getCollection('speaker');
  return speakers
    .filter((s) => !isPlaceholderSpeaker(s))
    .map((s) => ({ params: { slug: s.data.slug }, props: { s } }));
}

const { s } = Astro.props;
---

<SpeakerPage lang="en" s={s} />
