---
// Englische Stadt-Detailseite — gleiche Komponente wie /stadt/<slug>/.
import { getCollection } from 'astro:content';
import CityPage from '../../../components/pages/CityPage.astro';

export async function getStaticPaths() {
  const cities = await getCollection('stadt');
  return cities.map((c) => ({ params: { slug: c.data.slug }, props: { c } }));
}

const { c } = Astro.props;
---

<CityPage lang="en" c={c} />
