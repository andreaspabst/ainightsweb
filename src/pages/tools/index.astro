---
import { getCollection } from 'astro:content';
import { todayBerlin } from '../../lib/eventDates';
import Layout from '../../layouts/Layout.astro';
import { mediaExists, mediaList } from '../../lib/media';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolPane from '../../components/ToolPane.astro';

// Interne Übersicht über pro Event generierte Produktionsmedien (Speaker-
// Fotos, Speaker-Intro-Videos, Announcement-Grafiken, Sponsor-Logos) — kein
// Content für Besucher:innen, deshalb noindex und nirgends verlinkt.

const exists = (p: string) => mediaExists(p);
// Erwartete Countdown-Stufen (Skill event-social-posts: --countdown 14,10,2).
const COUNTDOWN_LEVELS = [14, 10, 2];

const [events, speakers, sponsors] = await Promise.all([
  getCollection('events'),
  getCollection('speaker'),
  getCollection('sponsor'),
]);

const speakerById = new Map(speakers.map((s) => [s.data.id, s.data]));
const sponsorById = new Map(sponsors.map((s) => [s.data.id, s.data]));

function mediaFor(personSlug: string) {
  return {
    introVideo: exists(`/media/speaker-intros/${personSlug}.mp4`) ? `/media/speaker-intros/${personSlug}.mp4` : null,
    instagram: exists(`/media/speaker-announcements/${personSlug}-instagram.png`) ? `/media/speaker-announcements/${personSlug}-instagram.png` : null,
    linkedin: exists(`/media/speaker-announcements/${personSlug}-linkedin.png`) ? `/media/speaker-announcements/${personSlug}-linkedin.png` : null,
  };
}

/** Karte pro Event in beiden Zuschnitten: Instagram (Portrait), LinkedIn (Landscape). */
function bothFormats(dir: string, eventSlug: string) {
  const at = (fmt: string) => {
    const p = `/media/${dir}/${eventSlug}-${fmt}.png`;
    return exists(p) ? p : null;
  };
  return { instagram: at('instagram'), linkedin: at('linkedin') };
}

/** Save-the-Date-Karten, erzeugt von scripts/generate-save-the-date.mjs. */
const saveTheDateFor = (eventSlug: string) => bothFormats('save-the-date', eventSlug);

/** Event-Tag-Karten „HEUTE 17:00 UHR“, erzeugt von scripts/generate-event-day.mjs. */
const eventDayFor = (eventSlug: string) => bothFormats('event-day', eventSlug);

/** Countdown-Karten „NUR NOCH … TAGE", erzeugt mit --countdown <n>. */
function countdownFor(eventSlug: string) {
  return listDir('/media/countdown')
    .filter((f) => f.startsWith(`${eventSlug}-`) && f.endsWith('-instagram.png'))
    .map((f) => ({
      days: Number(f.slice(eventSlug.length + 1, -'-instagram.png'.length)),
      instagram: `/media/countdown/${f}`,
      linkedin: exists(`/media/countdown/${f.replace('-instagram.png', '-linkedin.png')}`)
        ? `/media/countdown/${f.replace('-instagram.png', '-linkedin.png')}`
        : null,
    }))
    .filter((c) => Number.isFinite(c.days))
    .sort((a, b) => b.days - a.days);
}

function lineupFor(eventSlug: string) {
  return {
    instagram: exists(`/media/event-lineups/${eventSlug}-instagram.png`) ? `/media/event-lineups/${eventSlug}-instagram.png` : null,
    linkedin: exists(`/media/event-lineups/${eventSlug}-linkedin.png`) ? `/media/event-lineups/${eventSlug}-linkedin.png` : null,
  };
}

const slideNo = (f: string) => Number(f.match(/slide-(\d+)/)?.[1] ?? 0);
function listDir(rel: string): string[] {
  return mediaList(rel, '.png');
}

/** Event-Karussell (Line-up → Talks → Follow), je Format sortiert. */
function carouselFor(eventSlug: string) {
  const files = listDir(`/media/event-carousels/${eventSlug}`);
  const byFormat = (fmt: string) =>
    files.filter((f) => f.endsWith(`-${fmt}.png`)).sort((a, b) => slideNo(a) - slideNo(b))
      .map((f) => `/media/event-carousels/${eventSlug}/${f}`);
  return { instagram: byFormat('instagram'), linkedin: byFormat('linkedin') };
}

/** Themen-Karussells (4 Slides pro Talk), gruppiert nach Speaker-Slug. */
function topicCarouselsFor(eventSlug: string, speakerSlugs: string[]) {
  const files = listDir(`/media/topic-carousels/${eventSlug}`);
  return speakerSlugs
    .map((slug) => {
      const mine = files.filter((f) => f.startsWith(`${slug}-slide-`));
      const byFormat = (fmt: string) =>
        mine.filter((f) => f.endsWith(`-${fmt}.png`)).sort((a, b) => slideNo(a) - slideNo(b))
          .map((f) => `/media/topic-carousels/${eventSlug}/${f}`);
      return { slug, instagram: byFormat('instagram'), linkedin: byFormat('linkedin') };
    })
    .filter((t) => t.instagram.length > 0);
}

/** #speakerintro-Karten pro Speaker und Event: Portrait (IG) + Landscape (LinkedIn). */
function introCardFor(eventSlug: string, speakerSlug: string) {
  const at = (fmt: string) => {
    const p = `/media/speaker-intro-cards/${eventSlug}/${speakerSlug}-${fmt}.png`;
    return exists(p) ? p : null;
  };
  return { instagram: at('instagram'), linkedin: at('linkedin') };
}

const today = todayBerlin();
const sorted = [...events].sort((a, b) => (a.data.eventDate ?? '').localeCompare(b.data.eventDate ?? ''));
const upcoming = sorted.filter((e) => (e.data.eventDate ?? '') >= today);
const past = sorted.filter((e) => (e.data.eventDate ?? '') < today).reverse();
const orderedEvents = [...upcoming, ...past];

const rows = orderedEvents.map((e) => {
  const speakerIds = [...(e.data.speakerIds ?? []), ...(e.data.moderatorIds ?? [])];
  const people = speakerIds
    .map((id) => speakerById.get(id))
    .filter((s): s is NonNullable<typeof s> => Boolean(s))
    .map((s) => ({ ...s, media: mediaFor(s.slug), introCard: introCardFor(e.data.slug, s.slug) }));
  const eventSponsors = (e.data.sponsorIds ?? [])
    .map((id) => sponsorById.get(id))
    .filter((s): s is NonNullable<typeof s> => Boolean(s));
  const speakerName = (slug: string) => people.find((p) => p.slug === slug)?.title ?? slug;
  return {
    event: e.data,
    people,
    sponsors: eventSponsors,
    lineup: lineupFor(e.data.slug),
    saveTheDate: saveTheDateFor(e.data.slug),
    eventDay: eventDayFor(e.data.slug),
    countdown: countdownFor(e.data.slug),
    carousel: carouselFor(e.data.slug),
    topicCarousels: topicCarouselsFor(e.data.slug, people.map((p) => p.slug)).map((t) => ({ ...t, name: speakerName(t.slug) })),
    isUpcoming: (e.data.eventDate ?? '') >= today,
  };
}).map((r) => {
  // „Vollständig“ je Kategorie: alles da, was die Skills pro Event erzeugen.
  // Kategorien ohne jeden Inhalt gelten als „Nicht vollständig“.
  const speakersOnly = r.people.filter((p) => p.role !== 'moderator');
  const all = <T,>(list: T[], ok: (x: T) => boolean) => list.length > 0 && list.every(ok);
  const both = (x: { instagram: string | null; linkedin: string | null }) => Boolean(x.instagram && x.linkedin);
  const status = {
    saveTheDate: both(r.saveTheDate),
    countdown: COUNTDOWN_LEVELS.every((d) => r.countdown.some((c) => c.days === d && c.linkedin)),
    eventDay: both(r.eventDay),
    lineup: both(r.lineup),
    carousel: r.carousel.instagram.length > 0 && r.carousel.linkedin.length > 0,
    topics: all(speakersOnly, (p) => r.topicCarousels.some((t) => t.slug === p.slug && t.linkedin.length > 0)),
    intro: all(speakersOnly, (p) => both(p.introCard)),
    people: all(r.people, (p) => Boolean(p.image?.src && p.media.introVideo && p.media.instagram && p.media.linkedin)),
    sponsors: all(r.sponsors, (s) => Boolean(s.logo?.src)),
  };
  return { ...r, status };
});
---

<Layout
  lang="de"
  title="Tools — Produktionsmedien pro Event"
  description="Interne Übersicht: Speaker-Fotos, Intro-Videos, Announcement-Grafiken und Sponsor-Logos pro AI-Nights-Event."
  path="/tools/"
  noindex={true}
>
  <Header lang="de" />
  <main class="tools">
    <div class="container">
      <h1 class="display-font">Produktionsmedien</h1>
      <p class="lead">
        Pro Event: Speaker-/Sponsor-Material, das für Ankündigungen und den Talk-Screen gebraucht wird.
        Die Kategorien sind zugeklappt und laden erst beim Öffnen ihre Bilder und Videos.
      </p>

      {rows.map(({ event, people, sponsors, lineup, saveTheDate, eventDay, countdown, carousel, topicCarousels, status, isUpcoming }, idx) => (
        <details class="event-block" data-status={isUpcoming ? 'upcoming' : 'past'} open={idx === 0}>
          <summary>
            <h2>
              {event.title}
              {event.eventDate && <span class="date">{event.eventDate}</span>}
              {!isUpcoming && <span class="badge">vergangen</span>}
            </h2>
          </summary>

          <ToolPane title="Save the Date" complete={status.saveTheDate}>
            {(saveTheDate.instagram || saveTheDate.linkedin) ? (
              <div class="lineup">
                {saveTheDate.instagram && (
                  <a href={saveTheDate.instagram} target="_blank" class="lineup-preview lineup-preview-tall">
                    <img data-src={saveTheDate.instagram} alt="" decoding="async" />
                    <span>Instagram (1080×1350)</span>
                  </a>
                )}
                {saveTheDate.linkedin && (
                  <a href={saveTheDate.linkedin} target="_blank" class="lineup-preview lineup-preview-wide">
                    <img data-src={saveTheDate.linkedin} alt="" decoding="async" />
                    <span>LinkedIn (1200×627)</span>
                  </a>
                )}
              </div>
            ) : <p class="empty">Noch nichts generiert.</p>}
          </ToolPane>

          <ToolPane title="Countdown „NUR NOCH … TAGE“" complete={status.countdown}>
            {countdown.length > 0 ? countdown.map((c) => (
              <div class="lineup">
                <a href={c.instagram} target="_blank" class="lineup-preview lineup-preview-tall">
                  <img data-src={c.instagram} alt="" decoding="async" />
                  <span>T-{c.days} · Instagram laden</span>
                </a>
                {c.linkedin && (
                  <a href={c.linkedin} target="_blank" class="lineup-preview lineup-preview-wide">
                    <img data-src={c.linkedin} alt="" decoding="async" />
                    <span>T-{c.days} · LinkedIn laden</span>
                  </a>
                )}
              </div>
            )) : <p class="empty">Noch nichts generiert.</p>}
          </ToolPane>

          <ToolPane title="Event-Tag „HEUTE“" complete={status.eventDay}>
            {(eventDay.instagram || eventDay.linkedin) ? (
              <div class="lineup">
                {eventDay.instagram && (
                  <a href={eventDay.instagram} target="_blank" class="lineup-preview lineup-preview-tall">
                    <img data-src={eventDay.instagram} alt="" decoding="async" />
                    <span>Instagram (1080×1350)</span>
                  </a>
                )}
                {eventDay.linkedin && (
                  <a href={eventDay.linkedin} target="_blank" class="lineup-preview lineup-preview-wide">
                    <img data-src={eventDay.linkedin} alt="" decoding="async" />
                    <span>LinkedIn (1200×627)</span>
                  </a>
                )}
              </div>
            ) : <p class="empty">Noch nichts generiert.</p>}
          </ToolPane>

          <ToolPane title="Line-up" complete={status.lineup}>
            {(lineup.instagram || lineup.linkedin) ? (
              <div class="lineup">
                {lineup.instagram && (
                  <a href={lineup.instagram} target="_blank" class="lineup-preview">
                    <img data-src={lineup.instagram} alt="" decoding="async" />
                    <span>Instagram laden</span>
                  </a>
                )}
                {lineup.linkedin && (
                  <a href={lineup.linkedin} target="_blank" class="lineup-preview lineup-preview-wide">
                    <img data-src={lineup.linkedin} alt="" decoding="async" />
                    <span>LinkedIn laden</span>
                  </a>
                )}
              </div>
            ) : <p class="empty">Noch nichts generiert.</p>}
          </ToolPane>

          <ToolPane title="Event-Karussell (Line-up → Talks → Follow)" complete={status.carousel}>
            {carousel.instagram.length > 0 ? (['instagram', 'linkedin'] as const).map((fmt) => (
              <div class="strip">
                <span class="strip-label">{fmt === 'instagram' ? 'Instagram' : 'LinkedIn'}</span>
                {carousel[fmt].map((src, i) => (
                  <a href={src} target="_blank" class={`slide ${fmt === 'linkedin' ? 'slide-wide' : ''}`}>
                    <img data-src={src} alt="" decoding="async" />
                    <span>Slide {i + 1}</span>
                  </a>
                ))}
              </div>
            )) : <p class="empty">Noch nichts generiert.</p>}
          </ToolPane>

          <ToolPane title="Themen-Karussells (Hook → Inhalt → Speaker → Follow)" complete={status.topics}>
            {topicCarousels.length > 0 ? topicCarousels.map((t) => (
              <div>
                <p class="strip-title">{t.name}</p>
                {(['instagram', 'linkedin'] as const).map((fmt) => (
                  <div class="strip">
                    <span class="strip-label">{fmt === 'instagram' ? 'Instagram' : 'LinkedIn'}</span>
                    {t[fmt].map((src, i) => (
                      <a href={src} target="_blank" class={`slide ${fmt === 'linkedin' ? 'slide-wide' : ''}`}>
                        <img data-src={src} alt="" decoding="async" />
                        <span>Slide {i + 1}</span>
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            )) : <p class="empty">Noch nichts generiert.</p>}
          </ToolPane>

          <ToolPane title="#speakerintro-Karten" complete={status.intro}>
            {people.some((p) => p.introCard.instagram || p.introCard.linkedin) ? (['instagram', 'linkedin'] as const).map((fmt) => (
              people.some((p) => p.introCard[fmt]) && (
                <div class="strip">
                  <span class="strip-label">{fmt === 'instagram' ? 'Instagram 1080×1350' : 'LinkedIn 1200×627'}</span>
                  {people.filter((p) => p.introCard[fmt]).map((p) => (
                    <a href={p.introCard[fmt]} target="_blank" class={`slide ${fmt === 'linkedin' ? 'slide-wide' : 'slide-tall'}`}>
                      <img data-src={p.introCard[fmt]} alt="" decoding="async" />
                      <span>{p.title}</span>
                    </a>
                  ))}
                </div>
              )
            )) : <p class="empty">Noch nichts generiert.</p>}
          </ToolPane>

          <ToolPane title="Speaker & Moderation" complete={status.people}>
            {people.length > 0 ? (
              <div class="grid">
                {people.map((p) => (
                  <article class="card">
                    {p.image?.src && <img data-src={p.image.src} alt={p.title} decoding="async" />}
                    <h3>{p.title}</h3>
                    <p class="role">{p.role === 'moderator' ? 'Moderator:in' : 'Speaker'}</p>
                    <div class="links">
                      {p.image?.src && <a href={p.image.src} target="_blank">Foto</a>}
                      {p.media.introVideo && <a href={p.media.introVideo} target="_blank">Video ansehen</a>}
                      {p.media.introVideo && <a href={p.media.introVideo} download={`${p.slug}-intro.mp4`}>Video laden (1080p)</a>}
                      {p.media.instagram && <a href={p.media.instagram} target="_blank">Instagram-Grafik</a>}
                      {p.media.linkedin && <a href={p.media.linkedin} target="_blank">LinkedIn-Grafik</a>}
                      {!p.media.introVideo && !p.media.instagram && !p.media.linkedin && (
                        <span class="missing">noch nichts generiert</span>
                      )}
                    </div>
                    {p.media.introVideo && (
                      <video data-src={p.media.introVideo} controls muted preload="none"></video>
                    )}
                  </article>
                ))}
              </div>
            ) : <p class="empty">Noch kein Line-up hinterlegt.</p>}
          </ToolPane>

          <ToolPane title="Sponsoren" complete={status.sponsors}>
            {sponsors.length > 0 ? (
              <div class="grid">
                {sponsors.map((s) => (
                  <article class="card card-sponsor">
                    {s.logo?.src && <img data-src={s.logo.src} alt={s.title} decoding="async" />}
                    <h3>{s.title}</h3>
                    <div class="links">
                      {s.logo?.src && <a href={s.logo.src} target="_blank">Logo</a>}
                    </div>
                  </article>
                ))}
              </div>
            ) : <p class="empty">Keine Sponsoren hinterlegt.</p>}
          </ToolPane>
        </details>
      ))}
    </div>
  </main>
  <Footer lang="de" />
</Layout>

<script>
  // Medien erst beim ersten Öffnen eines Panes laden: In den zugeklappten
  // Kategorien tragen <img>/<video> nur data-src, damit die Seite beim Laden
  // keine Bilder und keine Videos vom Server zieht.
  document.addEventListener(
    'toggle',
    (e) => {
      const el = e.target as HTMLElement;
      if (!(el instanceof HTMLDetailsElement) || !el.hasAttribute('data-pane') || !el.open) return;
      el.querySelectorAll<HTMLElement>('[data-src]').forEach((m) => {
        m.setAttribute('src', m.dataset.src!);
        m.removeAttribute('data-src');
        if (m instanceof HTMLVideoElement) m.load();
      });
    },
    true,
  );
</script>

<style>
  .tools {
    padding: 7rem 0 4rem;
  }

  /* Sicherheitsnetz: Die Produktionsmedien sind Retina-Exporte (bis 2160 px
     breit). Fehlt an einer Stelle die Größenklasse, sprengt ein einziges
     Bild sonst das Layout. */
  .tools img,
  .tools video {
    max-width: 100%;
    height: auto;
  }
  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--text-primary);
  }
  .lead {
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
  }
  .event-block {
    margin-bottom: 1.2rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--border);
  }
  .event-block > summary {
    cursor: pointer;
    list-style: none;
    margin-bottom: 0.9rem;
  }
  .event-block > summary::-webkit-details-marker {
    display: none;
  }
  .event-block > summary {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .event-block > summary::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-right: 2px solid var(--text-secondary);
    border-bottom: 2px solid var(--text-secondary);
    transform: rotate(-45deg);
    flex: none;
    transition: transform 0.15s ease;
  }
  .event-block[open] > summary::before {
    transform: rotate(45deg);
  }
  .event-block h2 {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    font-size: 1.4rem;
    color: var(--text-primary);
    margin: 0;
  }
  .date {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 500;
  }
  .badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(255,255,255,.08);
    color: var(--text-secondary);
  }
  .lineup {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .lineup-preview {
    display: block;
    width: 220px;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-glass);
  }
  .lineup-preview-wide {
    width: 320px;
  }
  .lineup-preview img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .lineup-preview-wide img {
    aspect-ratio: 1200/627;
  }
  .lineup-preview-tall img {
    aspect-ratio: 1080/1350;
  }
  .lineup-preview span {
    display: block;
    padding: 0.5rem 0.7rem;
    font-size: 0.78rem;
    color: var(--text-secondary);
  }
  .lineup-preview:hover span {
    color: var(--text-primary);
  }
  .subheading {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 1.5rem 0 1rem;
  }
  .strip {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }
  .strip-label {
    flex-basis: 100%;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .strip-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 1rem 0 0.4rem;
  }
  .slide {
    display: block;
    width: 132px;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-glass);
  }
  .slide img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .slide-wide {
    width: 200px;
  }
  .slide-wide img {
    aspect-ratio: 1200/627;
  }
  .slide-tall {
    width: 150px;
  }
  .slide-tall img {
    aspect-ratio: 1080/1350;
  }
  .slide span {
    display: block;
    padding: 0.3rem 0.5rem;
    font-size: 0.7rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .slide:hover span {
    color: var(--text-primary);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.2rem;
  }
  .card {
    background: var(--bg-glass);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1rem;
  }
  .card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 0.7rem;
  }
  .card-sponsor img {
    aspect-ratio: 16/9;
    object-fit: contain;
    background: rgba(255,255,255,.05);
  }
  .card h3 {
    font-size: 0.95rem;
    color: var(--text-primary);
    margin: 0 0 0.2rem;
  }
  .role {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0 0 0.6rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }
  .links a {
    font-size: 0.78rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgba(255,255,255,.06);
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }
  .links a:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }
  .missing {
    font-size: 0.78rem;
    color: var(--text-secondary);
    opacity: 0.6;
    font-style: italic;
  }
  .card video {
    width: 100%;
    border-radius: 10px;
  }
  .empty {
    color: var(--text-secondary);
    font-style: italic;
    font-size: 0.9rem;
  }
</style>
