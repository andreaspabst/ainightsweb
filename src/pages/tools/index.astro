---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Interne Übersicht über pro Event generierte Produktionsmedien (Speaker-
// Fotos, Speaker-Intro-Videos, Announcement-Grafiken, Sponsor-Logos) — kein
// Content für Besucher:innen, deshalb noindex und nirgends verlinkt.

const PUBLIC_DIR = path.join(process.cwd(), 'public');
const exists = (p: string) => fs.existsSync(path.join(PUBLIC_DIR, p));

const [events, speakers, sponsors] = await Promise.all([
  getCollection('events'),
  getCollection('speaker'),
  getCollection('sponsor'),
]);

const speakerById = new Map(speakers.map((s) => [s.data.id, s.data]));
const sponsorById = new Map(sponsors.map((s) => [s.data.id, s.data]));

function mediaFor(personSlug: string) {
  return {
    introVideo: exists(`/media/speaker-intros/${personSlug}.mp4`) ? `/media/speaker-intros/${personSlug}.mp4` : null,
    instagram: exists(`/media/speaker-announcements/${personSlug}-instagram.png`) ? `/media/speaker-announcements/${personSlug}-instagram.png` : null,
    linkedin: exists(`/media/speaker-announcements/${personSlug}-linkedin.png`) ? `/media/speaker-announcements/${personSlug}-linkedin.png` : null,
  };
}

function lineupFor(eventSlug: string) {
  return {
    instagram: exists(`/media/event-lineups/${eventSlug}-instagram.png`) ? `/media/event-lineups/${eventSlug}-instagram.png` : null,
    linkedin: exists(`/media/event-lineups/${eventSlug}-linkedin.png`) ? `/media/event-lineups/${eventSlug}-linkedin.png` : null,
  };
}

const slideNo = (f: string) => Number(f.match(/slide-(\d+)/)?.[1] ?? 0);
function listDir(rel: string): string[] {
  const abs = path.join(PUBLIC_DIR, rel);
  return fs.existsSync(abs) ? fs.readdirSync(abs).filter((f) => f.endsWith('.png')) : [];
}

/** Event-Karussell (Line-up → Talks → Follow), je Format sortiert. */
function carouselFor(eventSlug: string) {
  const files = listDir(`/media/event-carousels/${eventSlug}`);
  const byFormat = (fmt: string) =>
    files.filter((f) => f.endsWith(`-${fmt}.png`)).sort((a, b) => slideNo(a) - slideNo(b))
      .map((f) => `/media/event-carousels/${eventSlug}/${f}`);
  return { instagram: byFormat('instagram'), linkedin: byFormat('linkedin') };
}

/** Themen-Karussells (4 Slides pro Talk), gruppiert nach Speaker-Slug. */
function topicCarouselsFor(eventSlug: string, speakerSlugs: string[]) {
  const files = listDir(`/media/topic-carousels/${eventSlug}`);
  return speakerSlugs
    .map((slug) => {
      const mine = files.filter((f) => f.startsWith(`${slug}-slide-`));
      const byFormat = (fmt: string) =>
        mine.filter((f) => f.endsWith(`-${fmt}.png`)).sort((a, b) => slideNo(a) - slideNo(b))
          .map((f) => `/media/topic-carousels/${eventSlug}/${f}`);
      return { slug, instagram: byFormat('instagram'), linkedin: byFormat('linkedin') };
    })
    .filter((t) => t.instagram.length > 0);
}

/** #speakerintro-Karte (Portrait) pro Speaker und Event. */
function introCardFor(eventSlug: string, speakerSlug: string) {
  const p = `/media/speaker-intro-cards/${eventSlug}/${speakerSlug}.png`;
  return exists(p) ? p : null;
}

const today = '2026-09-01';
const sorted = [...events].sort((a, b) => (a.data.eventDate ?? '').localeCompare(b.data.eventDate ?? ''));
const upcoming = sorted.filter((e) => (e.data.eventDate ?? '') >= today);
const past = sorted.filter((e) => (e.data.eventDate ?? '') < today).reverse();
const orderedEvents = [...upcoming, ...past];

const rows = orderedEvents.map((e) => {
  const speakerIds = [...(e.data.speakerIds ?? []), ...(e.data.moderatorIds ?? [])];
  const people = speakerIds
    .map((id) => speakerById.get(id))
    .filter((s): s is NonNullable<typeof s> => Boolean(s))
    .map((s) => ({ ...s, media: mediaFor(s.slug), introCard: introCardFor(e.data.slug, s.slug) }));
  const eventSponsors = (e.data.sponsorIds ?? [])
    .map((id) => sponsorById.get(id))
    .filter((s): s is NonNullable<typeof s> => Boolean(s));
  const speakerName = (slug: string) => people.find((p) => p.slug === slug)?.title ?? slug;
  return {
    event: e.data,
    people,
    sponsors: eventSponsors,
    lineup: lineupFor(e.data.slug),
    carousel: carouselFor(e.data.slug),
    topicCarousels: topicCarouselsFor(e.data.slug, people.map((p) => p.slug)).map((t) => ({ ...t, name: speakerName(t.slug) })),
    isUpcoming: (e.data.eventDate ?? '') >= today,
  };
});
---

<Layout
  lang="de"
  title="Tools — Produktionsmedien pro Event"
  description="Interne Übersicht: Speaker-Fotos, Intro-Videos, Announcement-Grafiken und Sponsor-Logos pro AI-Nights-Event."
  path="/tools/"
  noindex={true}
>
  <Header lang="de" />
  <main class="tools">
    <div class="container">
      <h1 class="display-font">Produktionsmedien</h1>
      <p class="lead">Pro Event: Speaker-/Sponsor-Material, das für Ankündigungen und den Talk-Screen gebraucht wird.</p>

      {rows.map(({ event, people, sponsors, lineup, carousel, topicCarousels, isUpcoming }) => (
        <section class="event-block" data-status={isUpcoming ? 'upcoming' : 'past'}>
          <h2>
            {event.title}
            {event.eventDate && <span class="date">{event.eventDate}</span>}
            {!isUpcoming && <span class="badge">vergangen</span>}
          </h2>

          {(lineup.instagram || lineup.linkedin) && (
            <div class="lineup">
              {lineup.instagram && (
                <a href={lineup.instagram} target="_blank" class="lineup-preview">
                  <img src={lineup.instagram} alt="" loading="lazy" />
                  <span>Line-up · Instagram laden</span>
                </a>
              )}
              {lineup.linkedin && (
                <a href={lineup.linkedin} target="_blank" class="lineup-preview lineup-preview-wide">
                  <img src={lineup.linkedin} alt="" loading="lazy" />
                  <span>Line-up · LinkedIn laden</span>
                </a>
              )}
            </div>
          )}

          {carousel.instagram.length > 0 && (
            <>
              <h3 class="subheading">Event-Karussell (Line-up → Talks → Follow)</h3>
              {(['instagram', 'linkedin'] as const).map((fmt) => (
                <div class="strip">
                  <span class="strip-label">{fmt === 'instagram' ? 'Instagram' : 'LinkedIn'}</span>
                  {carousel[fmt].map((src, i) => (
                    <a href={src} target="_blank" class={`slide ${fmt === 'linkedin' ? 'slide-wide' : ''}`}>
                      <img src={src} alt="" loading="lazy" />
                      <span>Slide {i + 1}</span>
                    </a>
                  ))}
                </div>
              ))}
            </>
          )}

          {topicCarousels.length > 0 && (
            <>
              <h3 class="subheading">Themen-Karussells (Hook → Inhalt → Speaker → Follow)</h3>
              {topicCarousels.map((t) => (
                <div>
                  <p class="strip-title">{t.name}</p>
                  {(['instagram', 'linkedin'] as const).map((fmt) => (
                    <div class="strip">
                      <span class="strip-label">{fmt === 'instagram' ? 'Instagram' : 'LinkedIn'}</span>
                      {t[fmt].map((src, i) => (
                        <a href={src} target="_blank" class={`slide ${fmt === 'linkedin' ? 'slide-wide' : ''}`}>
                          <img src={src} alt="" loading="lazy" />
                          <span>Slide {i + 1}</span>
                        </a>
                      ))}
                    </div>
                  ))}
                </div>
              ))}
            </>
          )}

          {people.some((p) => p.introCard) && (
            <>
              <h3 class="subheading">#speakerintro-Karten (Portrait 1080×1350)</h3>
              <div class="strip">
                {people.filter((p) => p.introCard).map((p) => (
                  <a href={p.introCard} target="_blank" class="slide slide-tall">
                    <img src={p.introCard} alt="" loading="lazy" />
                    <span>{p.title}</span>
                  </a>
                ))}
              </div>
            </>
          )}

          {people.length > 0 && (
            <div class="grid">
              {people.map((p) => (
                <article class="card">
                  {p.image?.src && <img src={p.image.src} alt={p.title} loading="lazy" />}
                  <h3>{p.title}</h3>
                  <p class="role">{p.role === 'moderator' ? 'Moderator:in' : 'Speaker'}</p>
                  <div class="links">
                    {p.image?.src && <a href={p.image.src} target="_blank">Foto</a>}
                    {p.media.introVideo && <a href={p.media.introVideo} target="_blank">Video ansehen</a>}
                    {p.media.introVideo && <a href={p.media.introVideo} download={`${p.slug}-intro.mp4`}>Video laden (1080p)</a>}
                    {p.media.instagram && <a href={p.media.instagram} target="_blank">Instagram-Grafik</a>}
                    {p.media.linkedin && <a href={p.media.linkedin} target="_blank">LinkedIn-Grafik</a>}
                    {!p.media.introVideo && !p.media.instagram && !p.media.linkedin && (
                      <span class="missing">noch nichts generiert</span>
                    )}
                  </div>
                  {p.media.introVideo && (
                    <video src={p.media.introVideo} controls muted preload="metadata"></video>
                  )}
                </article>
              ))}
            </div>
          )}

          {sponsors.length > 0 && (
            <>
              <h3 class="subheading">Sponsoren</h3>
              <div class="grid">
                {sponsors.map((s) => (
                  <article class="card card-sponsor">
                    {s.logo?.src && <img src={s.logo.src} alt={s.title} loading="lazy" />}
                    <h3>{s.title}</h3>
                    <div class="links">
                      {s.logo?.src && <a href={s.logo.src} target="_blank">Logo</a>}
                    </div>
                  </article>
                ))}
              </div>
            </>
          )}

          {people.length === 0 && sponsors.length === 0 && <p class="empty">Noch kein Line-up hinterlegt.</p>}
        </section>
      ))}
    </div>
  </main>
  <Footer lang="de" />
</Layout>

<style>
  .tools {
    padding: 7rem 0 4rem;
  }
  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--text-primary);
  }
  .lead {
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
  }
  .event-block {
    margin-bottom: 3.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .event-block h2 {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    font-size: 1.4rem;
    color: var(--text-primary);
    margin-bottom: 1.2rem;
  }
  .date {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 500;
  }
  .badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(255,255,255,.08);
    color: var(--text-secondary);
  }
  .lineup {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .lineup-preview {
    display: block;
    width: 220px;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-glass);
  }
  .lineup-preview-wide {
    width: 320px;
  }
  .lineup-preview img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .lineup-preview-wide img {
    aspect-ratio: 1200/627;
  }
  .lineup-preview span {
    display: block;
    padding: 0.5rem 0.7rem;
    font-size: 0.78rem;
    color: var(--text-secondary);
  }
  .lineup-preview:hover span {
    color: var(--text-primary);
  }
  .subheading {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 1.5rem 0 1rem;
  }
  .strip {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }
  .strip-label {
    flex-basis: 100%;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .strip-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 1rem 0 0.4rem;
  }
  .slide {
    display: block;
    width: 132px;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-glass);
  }
  .slide img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .slide-wide {
    width: 200px;
  }
  .slide-wide img {
    aspect-ratio: 1200/627;
  }
  .slide-tall {
    width: 150px;
  }
  .slide-tall img {
    aspect-ratio: 1080/1350;
  }
  .slide span {
    display: block;
    padding: 0.3rem 0.5rem;
    font-size: 0.7rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .slide:hover span {
    color: var(--text-primary);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.2rem;
  }
  .card {
    background: var(--bg-glass);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1rem;
  }
  .card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 0.7rem;
  }
  .card-sponsor img {
    aspect-ratio: 16/9;
    object-fit: contain;
    background: rgba(255,255,255,.05);
  }
  .card h3 {
    font-size: 0.95rem;
    color: var(--text-primary);
    margin: 0 0 0.2rem;
  }
  .role {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0 0 0.6rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }
  .links a {
    font-size: 0.78rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgba(255,255,255,.06);
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }
  .links a:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }
  .missing {
    font-size: 0.78rem;
    color: var(--text-secondary);
    opacity: 0.6;
    font-style: italic;
  }
  .card video {
    width: 100%;
    border-radius: 10px;
  }
  .empty {
    color: var(--text-secondary);
    font-style: italic;
    font-size: 0.9rem;
  }
</style>
