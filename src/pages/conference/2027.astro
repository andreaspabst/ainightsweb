---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { imgVariant } from '../../lib/images';

// AXDN//27 · THE AI Conference — 22.04.2027, KORN'S Nürnberg. Eigenständiger
// Teaser auf ainights.ai, der auf axdn.io verlinkt. Ab dem Footer-Link
// öffentlich erreichbar.
const ticketUrl = 'https://axdn.io/?jtr=AINIGHTS_LP';
const countdownTarget = '2027-04-22T09:00:00+02:00';

const tracks = [
  { icon: '🛠️', name: 'AI for Engineers', text: 'Agenten, Architekturen und Workflows, die auch in Produktion noch stehen — nicht nur in der Demo.' },
  { icon: '📣', name: 'AI for Marketing', text: 'Content, Kampagnen und Personalisierung, die tatsächlich Wirkung zeigen statt nur Buzzwords zu bedienen.' },
  { icon: '🧑‍🤝‍🧑', name: 'AI for HR', text: 'Recruiting, People Analytics und Change-Management — hands-on für Teams, die KI im Alltag einführen müssen.' },
  { icon: '💬', name: 'Open Space', text: 'Unconference-Fläche für die Themen, die der Community wichtig sind — nicht vorab festgelegt, sondern vor Ort entstanden.' },
];

const spaces = [
  { icon: '🎤', name: 'Main Stage', text: 'Opening, Keynotes und die großen Gespräche des Tages — für alle gemeinsam.' },
  { icon: '🗂️', name: '5 Workshop-Räume', text: 'Parallele Sessions zu allen vier Tracks plus Open Space, zum Mitmachen statt nur Zuhören.' },
  { icon: '🏢', name: 'Expo Area', text: 'Wo Tools, Teams und Partner zum Anfassen sind — zwischen den Sessions und in den Pausen.' },
];

const korns = [
  { src: '/wp-content/uploads/2026/08/korns-hall.webp', alt: 'KORN’S Nürnberg – Haupthalle' },
  { src: '/wp-content/uploads/2026/08/korns-conf-room.webp', alt: 'KORN’S Nürnberg – Konferenzraum' },
  { src: '/wp-content/uploads/2026/08/korns-dachterasse.jpg', alt: 'KORN’S Nürnberg – Dachterrasse' },
  { src: '/wp-content/uploads/2026/08/korns-bar.webp', alt: 'KORN’S Nürnberg – Bar & Lounge' },
  { src: '/wp-content/uploads/2026/08/korns-restaurant.webp', alt: 'KORN’S Nürnberg – Restaurant' },
  { src: '/wp-content/uploads/2026/08/korns-aussenansicht.jpg', alt: 'KORN’S Nürnberg – Außenansicht' },
];

const communityPhotos = [
  '/wp-content/uploads/2026/04/AI-Nights-Nuernberg-03-88.jpg',
  '/wp-content/uploads/2026/04/AI-Nights-Nuernberg-03-58.jpg',
  '/wp-content/uploads/2026/04/AI-Nights-Nuernberg-03-3.jpg',
  '/wp-content/uploads/2026/07/44-ai-night.25mai-44.jpg',
  '/wp-content/uploads/2026/07/61-ai-night.25mai-61.jpg',
  '/wp-content/uploads/2026/07/35-ai-night.25mai-35.jpg',
  '/wp-content/uploads/2026/01/1-94.jpg',
  '/wp-content/uploads/2026/01/1-27.jpg',
  '/wp-content/uploads/2026/01/12-ianight-12-scaled.jpg',
  '/wp-content/uploads/2026/01/29-ianight-29-scaled.jpg',
];

const curators = [
  { name: 'Andrea Reindel', role: 'Kuratorin AI for Marketing · Ex-AI HUB Nürnberg', image: '/wp-content/uploads/2026/08/andrea-reindel.png' },
  { name: 'Prof. Dr. Frank Müller', role: 'Kurator AI for HR · Gründer HR-Future, FOM Hochschule', image: null },
];

const speakerNames = ['Andreas Pabst', 'Alex Key', 'Dr. Konrad Körner', 'Roland Golla', 'Thomas Schönherr'];

const offPoints = [
  'Trends nur aus LinkedIn-Posts und Newslettern',
  'Ein Track für alle, egal ob Engineering, Marketing oder HR',
  'Folien statt echter Hands-on-Praxis',
  'Kein direkter Draht zu Teams, die KI wirklich einsetzen',
];
const onPoints = [
  'Eigener Track für Engineering, Marketing, HR und offene Themen',
  'Direkter Austausch mit Speaker:innen statt Sales-Pitches',
  'Ein Tag, an dem Theorie und Praxis zusammenkommen',
  'Netzwerk aus Machern statt nur Zuschauern',
];
---

<Layout
  lang="de"
  title="AXDN // 27 — THE AI Conference · 22. April 2027, Nürnberg"
  description="AXDN // 27: ein Tag, vier Tracks, eine Main Stage. Die AI Conference in Nürnberg, powered by AI Nights. 22. April 2027 im KORN'S Nürnberg."
  path="/conference/2027/"
>
  <Header lang="de" />
  <main class="ax">
    <section class="ax-hero">
      <img class="ax-hero-bg" src={imgVariant(communityPhotos[0], 1600)} alt="" role="presentation" />
      <div class="ax-hero-duotone"></div>
      <div class="ax-hero-overlay"></div>
      <div class="container ax-hero-inner">
        <p class="ax-kicker">✨ AXDN&nbsp;//&nbsp;27 · powered by AI Nights</p>
        <h1 class="display-font">Eine Konferenz. Vier Tracks.<br />Ein Tag, an dem KI <span class="ax-accent">gebaut</span> statt nur besprochen wird.</h1>
        <p class="ax-hero-sub">THE AI Conference für alle, die KI-Entscheidungen im Unternehmen wirklich treffen — Engineering, Marketing, HR. Keine Verkaufsshow, sondern ein Tag unter Leuten, die es selbst machen.</p>
        <div class="ax-chips">
          <span class="ax-chip">📅 22. April 2027</span>
          <span class="ax-chip">📍 KORN'S Nürnberg</span>
          <span class="ax-chip">🗂️ 4 Tracks</span>
          <span class="ax-chip">🎤 Main Stage</span>
        </div>
        <div class="ax-hero-actions">
          <a href={ticketUrl} target="_blank" rel="noopener" class="btn btn-primary">Tickets auf axdn.io ↗</a>
          <a href="#tracks" class="btn btn-ghost">Programm entdecken</a>
        </div>
        <div class="ax-countdown" data-countdown={countdownTarget}>
          <div class="ax-cd-box"><strong data-cd-d>00</strong><span>Tage</span></div>
          <div class="ax-cd-box"><strong data-cd-h>00</strong><span>Std</span></div>
          <div class="ax-cd-box"><strong data-cd-m>00</strong><span>Min</span></div>
          <div class="ax-cd-box"><strong data-cd-s>00</strong><span>Sek</span></div>
        </div>
      </div>
    </section>

    <div class="container ax-body">
      {/* Vergleich */}
      <section class="ax-sec ax-compare" data-reveal>
        <h2 class="display-font ax-compare-headline">
          Die meisten KI-Konferenzen zeigen dir <span class="ax-strike">noch mehr Folien und Buzzwords</span>.<br />
          Wir zeigen dir, <span class="ax-accent-text">wie andere Teams KI wirklich in Produktion bringen</span>.
        </h2>
        <div class="ax-compare-grid">
          <div class="ax-compare-col ax-compare-off">
            <p class="ax-compare-label">— Allein weitermachen</p>
            <ul>
              {offPoints.map((p) => <li><span class="ax-x">×</span>{p}</li>)}
            </ul>
          </div>
          <div class="ax-compare-col ax-compare-on">
            <p class="ax-compare-label">+ Bei AXDN // 27 dabei sein</p>
            <ul>
              {onPoints.map((p) => <li><span class="ax-plus">+</span>{p}</li>)}
            </ul>
          </div>
        </div>
      </section>

      {/* Tracks */}
      <section class="ax-sec" id="tracks" data-reveal>
        <p class="ax-eyebrow2">Vier Perspektiven, ein Tag</p>
        <h2 class="display-font ax-h2">Die Tracks</h2>
        <div class="ax-track-grid">
          {tracks.map((t) => (
            <div class="ax-track-card">
              <span class="ax-track-icon">{t.icon}</span>
              <h3>{t.name}</h3>
              <p>{t.text}</p>
            </div>
          ))}
        </div>
      </section>

      {/* Spaces */}
      <section class="ax-sec" data-reveal>
        <p class="ax-eyebrow2">Wo es passiert</p>
        <h2 class="display-font ax-h2">Ein Haus, drei Bühnen</h2>
        <div class="ax-space-grid">
          {spaces.map((s) => (
            <div class="ax-space-card">
              <span class="ax-space-icon">{s.icon}</span>
              <h3>{s.name}</h3>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
      </section>

      {/* Location */}
      <section class="ax-sec ax-wide" data-reveal>
        <p class="ax-eyebrow2">Wo es stattfindet</p>
        <h2 class="display-font ax-h2">KORN'S Nürnberg</h2>
        <div class="ax-loc-split">
          <div class="ax-loc-slider" data-ax-slider>
            <div class="ax-loc-track" data-ax-track>
              {korns.map((img, i) => (
                <div class="ax-loc-slide">
                  <img src={imgVariant(img.src, 800)} alt={img.alt} loading={i === 0 ? 'eager' : 'lazy'} />
                </div>
              ))}
            </div>
            <button type="button" class="ax-loc-nav ax-loc-prev" data-ax-prev aria-label="Vorheriges Bild">‹</button>
            <button type="button" class="ax-loc-nav ax-loc-next" data-ax-next aria-label="Nächstes Bild">›</button>
            <div class="ax-loc-dots" data-ax-dots>
              {korns.map((_, i) => <button type="button" class="ax-loc-dot" data-ax-dot={i} aria-label={`Bild ${i + 1} anzeigen`}></button>)}
            </div>
          </div>
          <div class="ax-loc-info">
            <p class="ax-loc-text">Kornmarkt 5–7, 90402 Nürnberg</p>
            <ul class="ax-loc-perks">
              <li><span class="ax-loc-perk-icon">📍</span>Mitten in der Nürnberger Altstadt</li>
              <li><span class="ax-loc-perk-icon">🎨</span>Bar, Restaurant und Dachterrasse statt steriler Messehalle</li>
              <li><span class="ax-loc-perk-icon">🚇</span>U-Bahn: U2 bis Opernhaus, dann ca. 5 Minuten zu Fuß</li>
              <li><span class="ax-loc-perk-icon">🚗</span>Parken: Parkhaus Sterntor gleich um die Ecke</li>
            </ul>
            <a href="https://www.google.com/maps/search/?api=1&query=KORN%27S%20Kornmarkt%205-7%20N%C3%BCrnberg" target="_blank" rel="noopener" class="btn btn-ghost">Auf Google Maps öffnen ↗</a>
          </div>
        </div>
      </section>

      {/* Community-Fotos */}
      <section class="ax-sec" data-reveal>
        <p class="ax-eyebrow2">Die Community dahinter</p>
        <h2 class="display-font ax-h2">AXDN wächst aus den AI Nights</h2>
        <p class="ax-community-sub">Echte Gesichter, echte Gespräche — die Menschen, die AXDN // 27 zur Konferenz machen, treffen sich schon heute bei den AI Nights.</p>
        <div class="ax-photo-grid">
          {communityPhotos.map((src) => (
            <div class="ax-photo">
              <img src={imgVariant(src, 400)} alt="Impression von einer AI Nights" loading="lazy" />
            </div>
          ))}
        </div>
      </section>

      {/* Kuratoren & Speaker */}
      <section class="ax-sec" data-reveal>
        <p class="ax-eyebrow2">Kuratiert von Menschen vom Fach</p>
        <h2 class="display-font ax-h2">Kuratorinnen & Kuratoren</h2>
        <div class="ax-curator-grid">
          {curators.map((c) => (
            <div class="ax-curator-card">
              {c.image
                ? <img src={imgVariant(c.image, 320)} alt={c.name} loading="lazy" />
                : <span class="ax-curator-fallback">✨</span>}
              <h3>{c.name}</h3>
              <p>{c.role}</p>
            </div>
          ))}
        </div>
        <p class="ax-speaker-teaser">
          Erste bestätigte Speaker:innen: <strong>{speakerNames.join(', ')}</strong> und weitere.
        </p>
        <div class="center">
          <a href={ticketUrl} target="_blank" rel="noopener" class="btn btn-ghost">Ganzes Line-up auf axdn.io ↗</a>
        </div>
      </section>

      {/* Abschluss-CTA */}
      <section class="ax-cta" data-reveal>
        <h2 class="display-font">Sei dabei, wenn KI nicht nur erklärt, sondern <span class="ax-accent-text">gebaut</span> wird.</h2>
        <p class="ax-cta-sub">22. April 2027 · KORN'S Nürnberg · Main Stage, vier Tracks, eine Community.</p>
        <a href={ticketUrl} target="_blank" rel="noopener" class="btn btn-primary">Tickets auf axdn.io ↗</a>
      </section>
    </div>
  </main>
  <Footer lang="de" />
</Layout>

<script>
  function initCountdown() {
    const el = document.querySelector<HTMLElement>('[data-countdown]');
    if (!el) return;
    const target = new Date(el.dataset.countdown ?? '').getTime();
    if (Number.isNaN(target)) return;
    const dEl = el.querySelector('[data-cd-d]');
    const hEl = el.querySelector('[data-cd-h]');
    const mEl = el.querySelector('[data-cd-m]');
    const sEl = el.querySelector('[data-cd-s]');
    let timer: ReturnType<typeof setInterval>;
    function tick() {
      const diff = Math.max(0, target - Date.now());
      const days = Math.floor(diff / 86400000);
      const hours = Math.floor((diff % 86400000) / 3600000);
      const mins = Math.floor((diff % 3600000) / 60000);
      const secs = Math.floor((diff % 60000) / 1000);
      if (dEl) dEl.textContent = String(days).padStart(2, '0');
      if (hEl) hEl.textContent = String(hours).padStart(2, '0');
      if (mEl) mEl.textContent = String(mins).padStart(2, '0');
      if (sEl) sEl.textContent = String(secs).padStart(2, '0');
      if (diff <= 0) clearInterval(timer);
    }
    tick();
    timer = setInterval(tick, 1000);
  }

  function initReveal() {
    const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (!('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
    );
    els.forEach((el) => io.observe(el));
  }

  function initSlider() {
    document.querySelectorAll<HTMLElement>('[data-ax-slider]').forEach((slider) => {
      const track = slider.querySelector<HTMLElement>('[data-ax-track]');
      const slides = Array.from(slider.querySelectorAll<HTMLElement>('.ax-loc-slide'));
      const dots = Array.from(slider.querySelectorAll<HTMLElement>('[data-ax-dot]'));
      const prev = slider.querySelector<HTMLElement>('[data-ax-prev]');
      const next = slider.querySelector<HTMLElement>('[data-ax-next]');
      if (!track || slides.length < 2) return;
      let index = 0;
      function render() {
        if (track) track.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((d, i) => d.classList.toggle('is-active', i === index));
      }
      function goTo(i: number) {
        index = (i + slides.length) % slides.length;
        render();
      }
      prev?.addEventListener('click', () => goTo(index - 1));
      next?.addEventListener('click', () => goTo(index + 1));
      dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
      let timer = setInterval(() => goTo(index + 1), 5000);
      slider.addEventListener('mouseenter', () => clearInterval(timer));
      slider.addEventListener('mouseleave', () => {
        timer = setInterval(() => goTo(index + 1), 5000);
      });
      render();
    });
  }

  initCountdown();
  initReveal();
  initSlider();
</script>

<style>
  /* AXDN // 27: eigene Markenfarben (Pink/Violett/Gold aus dem AXDN-Logo),
     lokal auf diese Seite begrenzt — unabhängig von der AI-Nights-Palette. */
  .ax {
    --ax-pink: #ef0460;
    --ax-violet: #3b1e99;
    --ax-gold: #f2b544;
    --ax-gradient: linear-gradient(120deg, #ef0460 0%, #3b1e99 100%);
    --ax-surface: linear-gradient(135deg, rgba(239, 4, 96, 0.18), rgba(59, 30, 153, 0.2)), rgba(255, 255, 255, 0.05);
    --ax-surface-border: rgba(239, 4, 96, 0.32);
  }
  .ax-accent {
    background: var(--ax-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ax-accent-text {
    background: var(--ax-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-style: italic;
  }

  .ax-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 10vw, 7rem) clamp(3.5rem, 8vw, 6rem);
  }
  .ax-hero-bg {
    position: absolute;
    inset: -3%;
    width: 106%;
    height: 106%;
    object-fit: cover;
    opacity: 0.55;
    filter: blur(3px) saturate(1.1);
  }
  .ax-hero-duotone {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(239, 4, 96, 0.45), rgba(59, 30, 153, 0.4));
    mix-blend-mode: color;
  }
  .ax-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(12, 4, 24, 0.35), var(--bg-base) 94%);
  }
  .ax-hero-inner {
    position: relative;
    text-align: center;
  }
  .ax-kicker {
    display: inline-block;
    background: var(--ax-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    margin-bottom: 0.9rem;
  }
  .ax-hero-inner h1 {
    max-width: 22ch;
    margin-inline: auto;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 1.3rem;
  }
  .ax-hero-sub {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 60ch;
    margin: 0 auto 1.8rem;
  }
  .ax-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 1.8rem;
  }
  .ax-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(239, 4, 96, 0.1);
    border: 1px solid rgba(239, 4, 96, 0.28);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .ax-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-bottom: 2rem;
  }
  .ax .btn-primary {
    background: var(--ax-gradient);
    position: relative;
    overflow: hidden;
  }
  .ax .btn-primary::after {
    content: '';
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.5), transparent);
    animation: ax-shine-sweep 3.2s ease-in-out infinite;
  }
  @keyframes ax-shine-sweep {
    0% { left: -60%; }
    45%, 100% { left: 130%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ax .btn-primary::after { animation: none; display: none; }
  }
  .ax-countdown {
    display: inline-flex;
    gap: 1rem;
    background: var(--ax-surface);
    border: 1px solid var(--ax-surface-border);
    border-radius: 20px;
    padding: 1rem 1.6rem;
  }
  .ax-cd-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 44px;
  }
  .ax-cd-box strong {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.3rem;
    background: var(--ax-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ax-cd-box span {
    font-size: 0.62rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ax-body {
    max-width: 980px;
    padding-block: 2rem 3rem;
  }
  .ax-sec {
    margin-bottom: 5rem;
  }
  .ax-eyebrow2 {
    text-align: center;
    color: var(--ax-gold);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }
  .ax-h2 {
    font-size: clamp(1.8rem, 4.2vw, 2.5rem);
    text-align: center;
    margin: 0 0 1.8rem;
  }

  /* Vergleich */
  .ax-compare {
    padding-block: 1.5rem;
  }
  .ax-compare-headline {
    font-size: clamp(2rem, 4.8vw, 3.2rem);
    line-height: 1.22;
    letter-spacing: -0.01em;
    text-align: center;
    max-width: 34ch;
    margin: 0 auto 3.6rem;
  }
  .ax-strike {
    color: var(--text-muted);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: rgba(255, 255, 255, 0.3);
  }
  .ax-compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .ax-compare-col {
    padding: 2rem;
    border-radius: 24px;
    border: 1px solid var(--border);
  }
  .ax-compare-off {
    background: var(--bg-elevated);
  }
  .ax-compare-on {
    background: var(--ax-surface);
    border-color: var(--ax-surface-border);
    box-shadow: 0 20px 50px -20px rgba(239, 4, 96, 0.3);
  }
  .ax-compare-label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
    font-weight: 700;
    margin: 0 0 1.2rem;
  }
  .ax-compare-off .ax-compare-label {
    color: var(--text-muted);
  }
  .ax-compare-on .ax-compare-label {
    color: var(--ax-gold);
  }
  .ax-compare-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .ax-compare-col li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .ax-compare-off li {
    color: var(--text-muted);
  }
  .ax-compare-on li {
    color: var(--text-primary);
    font-weight: 500;
  }
  .ax-x,
  .ax-plus {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
    border-radius: 50%;
