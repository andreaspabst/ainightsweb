---
export interface Props {
  lang?: 'de' | 'en';
  /**
   * Ziel des Sprachschalters. Seiten mit einem Gegenstück in der anderen
   * Sprache (z. B. /stadt/ ↔ /en/cities/) geben es hier an, damit der Wechsel
   * auf derselben Seite bleibt statt auf der Startseite zu landen.
   */
  switchHref?: string;
}
const { lang = 'de', switchHref } = Astro.props;

import { citiesHref, cityHref, speakersHref, foreignLang } from '../lib/i18n';

// Blog gibt es nur auf Deutsch — Sprachwechsel am Link auszeichnen,
// statt englische Besucher wortlos auf eine deutsche Seite zu schicken.
const deLink = foreignLang(lang);

const t = {
  de: {
    home: '/de/',
    cities: 'Städte',
    allCities: 'Alle Städte',
    speaker: 'Speaker',
    sponsors: 'Sponsoren',
    blog: 'Blog',
    gallery: 'Galerie',
    tickets: 'Tickets',
    nuernberg: 'AI Nights Nürnberg',
    muenchen: 'AI Nights München',
    bayreuth: 'AI Nights Bayreuth',
    hamburg: 'AI Nights Hamburg',
    ticketsHref: '/de/tickets/',
    sponsorsHref: '/de/sponsors/',
    galleryHref: '/de/galerie/',
    switchLabel: 'EN',
    switchHref: '/en/',
  },
  en: {
    home: '/en/',
    cities: 'Cities',
    allCities: 'All cities',
    speaker: 'Speakers',
    sponsors: 'Sponsors',
    blog: 'Blog',
    gallery: 'Gallery',
    tickets: 'Tickets',
    nuernberg: 'AI Nights Nuremberg',
    muenchen: 'AI Nights Munich',
    bayreuth: 'AI Nights Bayreuth',
    hamburg: 'AI Nights Hamburg',
    ticketsHref: '/en/tickets/',
    sponsorsHref: '/en/our-sponsors/',
    galleryHref: '/en/gallery/',
    switchLabel: 'DE',
    switchHref: '/de/',
  },
}[lang];

const langSwitchHref = switchHref ?? t.switchHref;
---

<header class="site-header">
  <div class="container bar">
    <a href={t.home} class="logo" aria-label="AI Nights">
      <img src="/wp-content/uploads/2026/07/AI-Nights-Logo-wAXDN.svg" alt="AI Nights" width="182" height="34" />
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      <div class="dropdown">
        <button type="button" class="drop-btn" aria-haspopup="true" aria-expanded="false">
          {t.cities}
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="drop-menu">
          <a href={cityHref('nuernberg', lang)}>{t.nuernberg}</a>
          <a href={cityHref('muenchen', lang)}>{t.muenchen}</a>
          <a href={cityHref('bayreuth', lang)}>{t.bayreuth}</a>
          <a href={cityHref('hamburg', lang)}>{t.hamburg}</a>
          <a href={citiesHref(lang)}>{t.allCities}</a>
        </div>
      </div>
      <a href={speakersHref(lang)}>{t.speaker}</a>
      <a href={t.sponsorsHref}>{t.sponsors}</a>
      <a href="/blog/" hreflang={deLink}>{t.blog}</a>
    </nav>

    <div class="actions">
      <a href={langSwitchHref} class="lang" hreflang={lang === 'de' ? 'en' : 'de'} aria-label="Sprache wechseln">{t.switchLabel}</a>
      <a href={t.ticketsHref} class="btn btn-primary tickets">{t.tickets}</a>
      <button type="button" class="burger" aria-label="Menü" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" hidden>
    <a href={cityHref('nuernberg', lang)}>{t.nuernberg}</a>
    <a href={cityHref('muenchen', lang)}>{t.muenchen}</a>
    <a href={cityHref('bayreuth', lang)}>{t.bayreuth}</a>
    <a href={cityHref('hamburg', lang)}>{t.hamburg}</a>
    <a href={citiesHref(lang)}>{t.allCities}</a>
    <a href={speakersHref(lang)}>{t.speaker}</a>
    <a href={t.sponsorsHref}>{t.sponsors}</a>
    <a href="/blog/" hreflang={deLink}>{t.blog}</a>
    <a href={t.ticketsHref} class="btn btn-primary">{t.tickets}</a>
    <a href={langSwitchHref} hreflang={lang === 'de' ? 'en' : 'de'}>{lang === 'de' ? 'English' : 'Deutsch'}</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 10px;
    z-index: 100;
    width: min(calc(100% - 24px), 1220px);
    margin-inline: auto;
    background: linear-gradient(135deg, rgba(21, 9, 43, 0.78), rgba(12, 3, 29, 0.62));
    backdrop-filter: blur(28px) saturate(170%);
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 22px;
    box-shadow: 0 18px 55px rgba(2,0,18,.34), inset 0 1px 0 rgba(255,255,255,.13);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 64px;
  }
  .logo img {
    height: 32px;
    width: auto;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin-inline: auto;
  }
  .nav > a,
  .drop-btn {
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.95rem;
    background: none;
    border: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0;
  }
  .nav > a:hover,
  .drop-btn:hover {
    color: var(--text-primary);
  }
  .dropdown {
    position: relative;
  }
  .dropdown::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: max(210px, 100%);
    height: 0.9rem;
  }
  .drop-menu {
    position: absolute;
    top: calc(100% + 0.9rem);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 210px;
    padding: 0.5rem;
    background: rgba(18, 7, 39, .86);
    backdrop-filter: blur(28px) saturate(160%);
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 18px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.18s ease;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }
  .dropdown:hover .drop-menu,
  .dropdown:focus-within .drop-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .drop-menu a {
    padding: 0.55rem 0.75rem;
    border-radius: 9px;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }
  .drop-menu a:hover {
    background: var(--bg-glass);
    color: var(--text-primary);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .lang {
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    border: 1px solid rgba(255,255,255,.16);
    background: rgba(255,255,255,.045);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
  }
  .lang:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }
  .tickets {
    padding: 0.6rem 1.2rem;
    font-size: 0.9rem;
  }
  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 6px;
  }
  .burger span {
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: 0.2s;
  }
  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.5rem 1.5rem;
    border-top: 1px solid var(--border);
    background: rgba(12,3,29,.96);
    border-radius: 0 0 22px 22px;
  }
  .mobile-menu a {
    color: var(--text-secondary);
    padding: 0.7rem 0.4rem;
    font-weight: 500;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }
  .mobile-menu a.btn {
    justify-content: center;
    margin-top: 0.6rem;
    color: #fff;
    border-bottom: none;
  }

  @media (max-width: 900px) {
    .nav,
    .tickets {
      display: none;
    }
    .burger {
      display: flex;
    }
    .mobile-menu[data-open='true'] {
      display: flex;
    }
  }
  @media (max-width: 520px) {
    .site-header { top: 6px; width: calc(100% - 12px); border-radius: 18px; }
    .bar { height: 58px; padding-inline: 1rem; }
    .logo img { height: 27px; }
  }
</style>

<script>
  const burger = document.querySelector('.burger');
  const menu = document.querySelector('.mobile-menu');
  burger?.addEventListener('click', () => {
    const open = menu?.getAttribute('data-open') === 'true';
    menu?.setAttribute('data-open', String(!open));
    if (menu) menu.hidden = open;
    burger.setAttribute('aria-expanded', String(!open));
  });
</script>
