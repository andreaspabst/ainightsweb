---
import { cityColor, cityLabel } from '../lib/cities';
import { imgVariant } from '../lib/images';
import AftershowBadge from './AftershowBadge.astro';
import CoOrganizerBadge from './CoOrganizerBadge.astro';
import { foreignLang } from '../lib/i18n';

export interface Props {
  slug: string;
  title: string;
  city?: string;
  eventDate?: string;
  locationName?: string;
  image?: { src?: string; alt?: string };
  excerpt?: string;
  ticketUrl?: string;
  /** Button-Position fürs Tracking (?jtr=/?ds24tr=), z. B. "HOME_EVENTCARD" */
  btnPos?: string;
  /** Aftershow-Party des Events (optional) — zeigt Partner-Logo + Kurzhinweis */
  aftershow?: { cardNote?: string; partnerLogo?: { src?: string; alt?: string }; partnerName?: string };
  /** Mitorganisator des Events (optional) — zeigt Partner-Logo + Label */
  coOrganizer?: { label?: string; name: string; logo?: { src?: string; alt?: string } };
  lang?: 'de' | 'en';
}
const { slug, title, city, eventDate, locationName, image, excerpt, ticketUrl, btnPos = 'EVENTCARD', aftershow, coOrganizer, lang = 'de' } = Astro.props;

function fmtDate(d?: string) {
  if (!d) return null;
  const parsed = new Date(d.replace(' ', 'T'));
  if (isNaN(parsed.getTime())) return d;
  return parsed.toLocaleDateString(lang === 'en' ? 'en-GB' : 'de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
}
const dateLabel = fmtDate(eventDate);

// Event-Detailseiten gibt es nur auf Deutsch — von einer englischen Seite aus
// den Sprachwechsel am Link auszeichnen statt ihn stillschweigend zu vollziehen.
const eventHreflang = foreignLang(lang);
const cityBadge = city ? cityLabel(city, lang) : undefined;
const detailsLabel = lang === 'en' ? 'Details' : 'Details';
---

<article class="event-card card">
  <a href={`/events/${slug}/`} class="cover" hreflang={eventHreflang}>
    {image?.src && <img src={imgVariant(image.src, 640)} alt={image.alt ?? title} loading="lazy" width="640" height="400" />}
    {city && <span class="city-badge" style={`background: ${cityColor(city)}`}>{cityBadge}</span>}
  </a>
  <div class="body">
    {dateLabel && <p class="date">{dateLabel}</p>}
    <h3><a href={`/events/${slug}/`} hreflang={eventHreflang}>{title}</a></h3>
    {locationName && <p class="loc">📍 {locationName}</p>}
    {excerpt && <p class="excerpt">{excerpt}</p>}
    {aftershow?.cardNote && (
      <AftershowBadge note={aftershow.cardNote} logo={aftershow.partnerLogo} logoAlt={aftershow.partnerName} />
    )}
    {coOrganizer && <CoOrganizerBadge label={coOrganizer.label} name={coOrganizer.name} city={city} logo={coOrganizer.logo} lang={lang} />}
    <div class="actions">
      <a href={`/events/${slug}/`} class="btn btn-ghost" hreflang={eventHreflang}>{detailsLabel}</a>
      {ticketUrl && <a href={ticketUrl} data-btn-pos={btnPos} class="btn btn-primary">Tickets</a>}
    </div>
  </div>
</article>

<style>
  .event-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 26px;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow .25s ease;
  }
  .event-card:hover {
    transform: translateY(-7px);
    border-color: var(--glass-border-hover);
    box-shadow: 0 32px 80px rgba(2,0,18,.5), inset 0 1px 0 rgba(255,255,255,.16);
  }
  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--bg-elevated);
    display: block;
    overflow: hidden;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .55s ease, filter .4s ease;
  }
  .event-card:hover .cover img { transform: scale(1.045); filter: saturate(1.12); }
  .cover::after { content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 48%,rgba(8,1,24,.68));pointer-events:none; }
  .city-badge {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    background: var(--gradient-accent);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    z-index: 2;
    border: 1px solid rgba(255,255,255,.24);
    backdrop-filter: blur(14px);
    box-shadow: inset 0 1px rgba(255,255,255,.2);
  }
  .body {
    padding: 1.2rem 1.3rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }
  .date {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--blue-bright);
  }
  h3 {
    font-size: 1.3rem;
    letter-spacing: -.035em;
  }
  h3 a {
    color: var(--text-primary);
  }
  h3 a:hover {
    color: var(--magenta-bright);
  }
  .loc {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .excerpt {
    font-size: 0.9rem;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .actions {
    margin-top: auto;
    padding-top: 0.8rem;
    display: flex;
    gap: 0.6rem;
  }
  .actions .btn {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }
</style>
