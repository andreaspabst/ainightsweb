---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { isPlaceholderSpeaker } from '../../lib/speakers';
import { imgVariant } from '../../lib/images';
import galleryData from '../../data/gallery.json';

export interface Props {
  e: Awaited<ReturnType<typeof getCollection<'events'>>>[number];
}

const { e } = Astro.props;
const d = e.data;

// Hero-Hintergrund: echtes Foto mit Menschen statt des Branding-Bilds (das trägt
// eingebrannten Titeltext und kollidiert mit der H1). Eigene Fotos hat diese
// Event-Reihe noch nicht — Fallback ist ein bewusst ausgewähltes Foto mit
// Frauen im Bild, statt eines zufälligen AI-Nights-Fotos.
const galleryGroup = (galleryData as { event: string; images: string[] }[]).find((g) => g.event === d.slug);
const heroBg = galleryGroup?.images[0] ?? '/wp-content/uploads/2026/04/AI-Nights-Nuernberg-03-88.jpg';

// Zweites, anderes Foto für die Zitat-Sektion weiter unten
const quotePool = (galleryData as { event: string; images: string[] }[]).flatMap((g) => g.images);
const quoteBg = quotePool.find((img) => img !== heroBg) ?? '/wp-content/uploads/2026/01/1-94.jpg';

const speakerColl = await getCollection('speaker');
const sessionColl = await getCollection('sessions');
const sponsorColl = await getCollection('sponsor');
const byId = (coll: any[]) => new Map(coll.filter((x) => x.data.id).map((x) => [x.data.id, x]));
const spMap = byId(speakerColl);
const seMap = byId(sessionColl);
const spoMap = byId(sponsorColl);

const resolve = (ids: number[] | undefined, m: Map<number, any>) =>
  (ids ?? []).map((id) => m.get(id)).filter(Boolean);

const speakerSlots = resolve(d.speakerIds, spMap);
const speakers = speakerSlots.filter((s) => !isPlaceholderSpeaker(s));
const tbaCount = speakerSlots.length - speakers.length;
const moderators = resolve(d.moderatorIds, spMap);
const sessions = resolve(d.sessionIds, seMap);
const sponsors = resolve(d.sponsorIds, spoMap);

function fmtDate(dt?: string) {
  if (!dt) return null;
  const p = new Date(dt);
  if (isNaN(p.getTime())) return dt;
  return p.toLocaleDateString('de-DE', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });
}
const dateLabel = fmtDate(d.eventDate);
const isPast = d.eventDate ? new Date(d.eventDate) < new Date('2026-07-14') : false;
const countdownTarget = !isPast && d.eventDate ? `${d.eventDate}T${d.startTime ?? '18:00'}:00` : null;

const mapsQuery = encodeURIComponent([d.locationName, d.locationAddress, d.city].filter(Boolean).join(', '));
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;

const ticketHref = !isPast && d.ticketUrl ? d.ticketUrl : '/de/tickets/';
const ticketExternal = !isPast && Boolean(d.ticketUrl);

const facts: { icon: string; label: string }[] = [
  { icon: '🎤', label: `${speakerSlots.length || 1} Speakerin${speakerSlots.length === 1 ? '' : 'nen'}${moderators.length ? ' & ' + moderators.length + ' Moderation' : ''}` },
  { icon: '🙌', label: 'Jede:r als Gast willkommen' },
  { icon: '🌟', label: 'Die Bühne gehört den Frauen' },
  { icon: '🗂️', label: 'Kurze Impuls-Sessions' },
  { icon: '🤝', label: 'Raum für echten Austausch' },
  { icon: '🥂', label: 'Inklusive Drinks & Snacks' },
];

// Leitgedanken für die Marquee in der Zitat-Sektion — bewusst als eigene
// Statements formuliert, nicht als erfundene Besucher:innen-Zitate (die Reihe
// steht noch am Anfang, es gibt noch keine echten Stimmen dazu).
const visionPillars = [
  'Sichtbarkeit auf der Bühne statt nur im Publikum',
  'Vorbilder, an denen man sich orientieren kann',
  'Ehrlicher Austausch statt Buzzword-Bingo',
  'Netzwerk, das über den Abend hinausträgt',
];

const faqItems = [
  { q: 'Sind auch Männer und andere Gäste willkommen?', a: 'Ja, ausdrücklich! Zu den AI Woman Nights ist jede:r als Gast willkommen, unabhängig vom Geschlecht. Nur die Bühne gehört bewusst den Frauen — Speakerinnen und Moderatorinnen stehen im Vordergrund, das Publikum ist gemischt.' },
  { q: 'Wer kann teilnehmen?', a: 'Jede:r ist als Gast willkommen — aber die Bühne gehört den Frauen. Die AI Woman Nights bringen gezielt Frauen zusammen, die sich für KI interessieren, sie beruflich einsetzen oder einfach neugierig sind.' },
  { q: 'Muss ich Vorwissen mitbringen?', a: 'Nein. Es geht um Austausch auf Augenhöhe, nicht um Expertenwissen. Neugier reicht völlig.' },
  { q: 'Wie funktioniert der Ticketkauf?', a: 'Du sicherst dir dein Ticket hier online und wirst direkt zum Zahlungsanbieter weitergeleitet. Nach dem Kauf bekommst du dein digitales Ticket per E-Mail.' },
  { q: 'Wollt ihr sponsern oder mitwirken?', a: 'Sehr gerne! Schreib einfach an reindel.andrea@gmail.com oder kontakt@andreas-pabst.de — wir freuen uns über Unterstützung und neue Speakerinnen.' },
];
---

<Layout
  lang="de"
  title={d.seo?.title ?? `${d.title} — AI Woman Nights`}
  description={d.seo?.description ?? d.excerpt ?? `${d.title} — ein AI Woman Nights Afterwork-Event${d.city ? ` in ${d.city}` : ''}.`}
  path={`/events/${d.slug}/`}
  image={d.image?.src}
  ogType="event"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: d.title,
    startDate: d.eventDate,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: d.locationName
      ? { '@type': 'Place', name: d.locationName, address: d.locationAddress ?? d.city }
      : undefined,
    image: d.image?.src ? `https://ainights.ai${d.image.src}` : undefined,
    description: d.excerpt,
    performer: speakers.map((s) => ({ '@type': 'Person', name: s.data.title })),
    organizer: { '@type': 'Organization', name: 'AI Woman Nights', url: 'https://ainights.ai' },
  }}
>
  <Header lang="de" />
  <main class="wn">
    <section class="wn-hero">
      <img class="wn-hero-bg" src={imgVariant(heroBg, 1600)} alt="" role="presentation" data-parallax="8" data-parallax-scale="1.1" />
      <div class="wn-hero-duotone"></div>
      <div class="wn-hero-overlay"></div>
      <div class="wn-bubbles" aria-hidden="true">
        <span class="wn-bubble" style="--size:230px; --x:6%; --y:62%; --dur:22s; --delay:-2s;"></span>
        <span class="wn-bubble wn-bubble-gold" style="--size:150px; --x:88%; --y:18%; --dur:17s; --delay:-6s;"></span>
        <span class="wn-bubble wn-bubble-gold" style="--size:110px; --x:78%; --y:72%; --dur:14s; --delay:-3s;"></span>
        <span class="wn-bubble" style="--size:75px; --x:18%; --y:14%; --dur:12s; --delay:-8s;"></span>
        <span class="wn-bubble" style="--size:280px; --x:48%; --y:88%; --dur:26s; --delay:-10s;"></span>
        <span class="wn-bubble wn-bubble-gold" style="--size:95px; --x:94%; --y:48%; --dur:15s; --delay:-1s;"></span>
      </div>
      <div class="container wn-hero-inner">
        <a href="/de/tickets/" class="wn-back">← Alle Events</a>
        <p class="wn-eyebrow">✨ AI Woman Nights{d.city ? ` · ${d.city}` : ''}</p>
        <h1 class="display-font">{d.title}</h1>
        {(d.contentHtml || d.excerpt) && (
          <div class="wn-intro prose">
            {d.contentHtml ? <div set:html={d.contentHtml} /> : <p>{d.excerpt}</p>}
          </div>
        )}
        <div class="wn-chips">
          {dateLabel && <span class="wn-chip"><span>📅</span>{dateLabel}</span>}
          {d.startTime && <span class="wn-chip"><span>🕕</span>{d.startTime} Uhr</span>}
          {d.locationName && <span class="wn-chip"><span>📍</span>{d.locationName}</span>}
        </div>
        <div class="wn-hero-bar">
          {speakers.length > 0 && (
            <a href="#lineup" class="wn-hero-bar-speakers">
              <span class="wn-hero-avatars">
                {speakers.slice(0, 5).map((s) => (
                  s.data.image?.src
                    ? <img src={imgVariant(s.data.image.src, 96)} alt="" loading="lazy" />
                    : <span class="wn-hero-avatar-fallback">✨</span>
                ))}
              </span>
              <span class="wn-hero-bar-label">{speakerSlots.length || speakers.length} Speakerin{(speakerSlots.length || speakers.length) === 1 ? '' : 'nen'} ↓</span>
            </a>
          )}
          {countdownTarget && (
            <div class="wn-countdown" data-countdown={countdownTarget}>
              <div class="wn-cd-box"><strong data-cd-d>00</strong><span>Tage</span></div>
              <div class="wn-cd-box"><strong data-cd-h>00</strong><span>Std</span></div>
              <div class="wn-cd-box"><strong data-cd-m>00</strong><span>Min</span></div>
              <div class="wn-cd-box"><strong data-cd-s>00</strong><span>Sek</span></div>
            </div>
          )}
          <a href={ticketHref} target={ticketExternal ? '_blank' : undefined} rel={ticketExternal ? 'noopener' : undefined} class="btn btn-primary">
            {isPast ? 'Kommende Events ansehen' : 'Tickets sichern'}
          </a>
        </div>
      </div>
    </section>

    <div class="container wn-body">
      {/* Mission */}
      <section class="wn-sec wn-mission" data-reveal>
        <span class="wn-mission-mark">„</span>
        <p class="wn-mission-lead">
          KI verändert alles — und keiner kann sich mehr wegducken. Wir sind der Meinung: Frauen müssen ganz vorne dabei sein.
          Nicht nur auf den Zuschauerplätzen, sondern auf der Bühne, an den Konferenztischen und mitten in Diskussionen dazu.
        </p>
        <p class="wn-mission-sub">Bei den AI Woman Nights ist Jede:r willkommen — aber die Bühne gehört den Frauen.</p>
      </section>

      {/* Facts */}
      <section class="wn-sec wn-facts" data-reveal>
        <ul>
          {facts.map((f) => (
            <li><span class="wn-fact-icon">{f.icon}</span><span>{f.label}</span></li>
          ))}
        </ul>
      </section>

      {/* Programm, falls vorhanden */}
      {sessions.length > 0 && (
        <section class="wn-sec" data-reveal>
          <p class="wn-eyebrow2">Der Abend</p>
          <h2 class="display-font wn-h2">Programm</h2>
          <div class="wn-stack">
            {sessions.map((s) => {
              const isBreak = /pause|break/i.test(s.data.title);
              const sp = (s.data.speakerIds ?? []).map((id: number) => spMap.get(id)).filter(Boolean).filter((x: any) => !isPlaceholderSpeaker(x));
              if (isBreak) {
                return <div class="wn-break">☕ {s.data.title}{s.data.duration && ` · ${s.data.duration} min`}</div>;
              }
              return (
                <article class="wn-stack-card">
                  {s.data.startTime && <span class="wn-stack-time">🕕 {s.data.startTime} Uhr</span>}
                  <h3>{s.data.title}</h3>
                  {sp.length > 0 && (
                    <p class="wn-stack-speaker">{sp.map((x: any) => x.data.title).join(', ')}</p>
                  )}
                  {s.data.excerpt && <p class="wn-stack-ex">{s.data.excerpt}</p>}
                </article>
              );
            })}
          </div>
        </section>
      )}

      {/* Organisation */}
      {moderators.length > 0 && (
        <section class="wn-sec" data-reveal>
          <p class="wn-eyebrow2">Wer euch durch den Abend führt</p>
          <h2 class="display-font wn-h2">Organisation</h2>
          <div class="wn-org-grid">
            {moderators.map((s) => (
              <a href={`/speaker/${s.data.slug}/`} class="wn-org-card">
                {s.data.image?.src && <img src={imgVariant(s.data.image.src, 320)} alt={s.data.title} loading="lazy" />}
                <h3>{s.data.title}</h3>
                {s.data.jobTitle && <p class="wn-org-role">{s.data.jobTitle}</p>}
                {s.data.excerpt && <p class="wn-org-bio">{s.data.excerpt}</p>}
              </a>
            ))}
          </div>
        </section>
      )}

      {/* Speakerinnen */}
      {(speakers.length > 0 || tbaCount > 0) && (
        <section class="wn-sec" id="lineup" data-reveal>
          <p class="wn-eyebrow2">Lerne von Frauen, die KI mitgestalten</p>
          <h2 class="display-font wn-h2">Speakerinnen des Abends</h2>
          <div class="wn-speaker-grid">
            {speakers.map((s) => (
              <div class="wn-speaker-card">
                <a href={`/speaker/${s.data.slug}/`} class="wn-speaker-photo-link">
                  {s.data.image?.src
                    ? <img src={imgVariant(s.data.image.src, 400)} alt={s.data.title} loading="lazy" />
                    : <span class="wn-speaker-photo-fallback">✨</span>}
                </a>
                <h3><a href={`/speaker/${s.data.slug}/`}>{s.data.title}</a></h3>
                {s.data.jobTitle && <p class="wn-speaker-role">{s.data.jobTitle}</p>}
                {s.data.bioHtml
                  ? <div class="wn-speaker-bio prose" set:html={s.data.bioHtml} />
                  : s.data.excerpt && <p class="wn-speaker-bio">{s.data.excerpt}</p>}
                {s.data.socials?.linkedin && (
                  <a href={s.data.socials.linkedin} target="_blank" rel="noopener" class="wn-speaker-social">LinkedIn ↗</a>
                )}
              </div>
            ))}
            {Array.from({ length: tbaCount }).map(() => (
              <div class="wn-speaker-card wn-speaker-tba">
                <span class="wn-speaker-photo-fallback">✨</span>
                <h3>Wird noch bekanntgegeben</h3>
                <p class="wn-speaker-role">Speakerin folgt in Kürze</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* Sponsoren, falls vorhanden */}
      {sponsors.length > 0 && (
        <section class="wn-sec" data-reveal>
          <p class="wn-eyebrow2">Möglich gemacht von</p>
          <h2 class="display-font wn-h2">Sponsoren dieses Events</h2>
          <div class="wn-sponsor-row">
            {sponsors.map((s) => (
              <a href={`/sponsor/${s.data.slug}/`} class="wn-sponsor-logo" title={s.data.title}>
                <img src={s.data.logo?.src ?? s.data.image?.src} alt={s.data.title} loading="lazy" />
              </a>
            ))}
          </div>
        </section>
      )}

      {/* Location */}
      {d.locationName && (
        <section class="wn-sec" data-reveal>
          <p class="wn-eyebrow2">Wo es stattfindet</p>
          <h2 class="display-font wn-h2">{d.locationName}</h2>
          <div class="wn-location-card">
            {d.locationAddress && <p class="wn-location-text">{d.locationAddress}</p>}
            <p class="wn-location-text">Zentral in {d.city ?? 'der Stadt'} gelegen, entspannte Atmosphäre.</p>
            <a href={mapsUrl} target="_blank" rel="noopener" class="btn btn-ghost">Auf Google Maps öffnen ↗</a>
          </div>
        </section>
      )}

      {/* Vision / Zitat-Sektion — bricht aus dem Container aus, echtes Foto + Marquee */}
      <section class="wn-sec wn-quote-parallax" data-reveal>
        <div class="wn-qp-bg" style={`background-image:url(${imgVariant(quoteBg, 1600)})`} data-parallax="14" data-parallax-scale="1.15"></div>
        <div class="wn-qp-duotone"></div>
        <div class="wn-qp-overlay"></div>
        <div class="wn-qp-inner">
          <span class="wn-qp-mark" aria-hidden="true">„</span>
          <p class="wn-qp-lead">
            Die AI Woman Nights sind aus den AI Nights heraus entstanden — mit der Premiere in Nürnberg als Startpunkt,
            <span class="wn-qp-highlight">nicht als Endpunkt</span>. Der Anspruch geht über einen einzelnen Abend hinaus:
            ein Ort, an dem Frauen sich sichtbar mit KI auseinandersetzen — nicht als Ausnahme, sondern als Selbstverständlichkeit.
          </p>
          <p class="wn-qp-lead">
            KI verändert Arbeitsweisen, Entscheidungen und ganze Branchen. Wer mitgestalten will, muss mitreden —
            und genau dafür schaffen wir hier Raum: offen, ehrlich und auf Augenhöhe.
          </p>
        </div>
        <div class="wn-qp-marquee">
          <div class="wn-qp-track">
            <div class="wn-qp-track-set">
              {visionPillars.map((v) => (
                <span class="wn-qp-pill">{v}</span>
              ))}
            </div>
            <div class="wn-qp-track-set" aria-hidden="true">
              {visionPillars.map((v) => (
                <span class="wn-qp-pill">{v}</span>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* Sponsoring gesucht */}
      <section class="wn-sec wn-sponsor-cta" data-reveal>
        <div class="wn-sponsor-cta-inner">
          <h2 class="display-font wn-h2-light">Sponsoring gesucht 🧡</h2>
          <p>
            Habt ihr Lust, oder kennt ihr ein Unternehmen, das die AI Woman Nights als Sponsor unterstützen möchte?
            Schreibt gerne direkt <a href="mailto:reindel.andrea@gmail.com">Andrea</a> oder <a href="mailto:kontakt@andreas-pabst.de">Andreas</a>.
          </p>
        </div>
      </section>

      {/* FAQ */}
      <section class="wn-sec" data-reveal>
        <p class="wn-eyebrow2">Fragen zum Event</p>
        <h2 class="display-font wn-h2">Häufige Fragen</h2>
        <div class="wn-faq-list">
          {faqItems.map((f) => (
            <details class="wn-faq-item">
              <summary>{f.q}<span class="wn-faq-icon">＋</span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="wn-cta" data-reveal>
        <h2 class="display-font wn-h2-light">{isPast ? 'Bei der nächsten AI Woman Night dabei sein' : 'Bereit, dabei zu sein?'}</h2>
        {!isPast && <p class="wn-cta-sub">Sichere dir jetzt dein Ticket — die Bühne gehört den Frauen.</p>}
        <a href={ticketHref} target={ticketExternal ? '_blank' : undefined} rel={ticketExternal ? 'noopener' : undefined} class="btn btn-primary">
          {isPast ? 'Kommende Events ansehen' : 'Tickets sichern'}
        </a>
      </section>
    </div>
  </main>

  {ticketExternal && (
    <div class="wn-sticky-cta" id="wn-sticky-cta">
      <div class="wn-sticky-inner">
        <span class="wn-sticky-date">
          {d.eventDate && new Date(d.eventDate).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' })}
          {d.city ? ` ${d.city}` : ''}
        </span>
        <a href={d.ticketUrl} target="_blank" rel="noopener" class="btn btn-primary">Tickets sichern</a>
      </div>
    </div>
  )}

  <Footer lang="de" />
</Layout>

<script>
  function initCountdowns() {
    document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
      const target = new Date(el.dataset.countdown ?? '').getTime();
      if (Number.isNaN(target)) return;
      const dEl = el.querySelector('[data-cd-d]');
      const hEl = el.querySelector('[data-cd-h]');
      const mEl = el.querySelector('[data-cd-m]');
      const sEl = el.querySelector('[data-cd-s]');
      let timer: ReturnType<typeof setInterval>;
      function tick() {
        const diff = Math.max(0, target - Date.now());
        const days = Math.floor(diff / 86400000);
        const hours = Math.floor((diff % 86400000) / 3600000);
        const mins = Math.floor((diff % 3600000) / 60000);
        const secs = Math.floor((diff % 60000) / 1000);
        if (dEl) dEl.textContent = String(days).padStart(2, '0');
        if (hEl) hEl.textContent = String(hours).padStart(2, '0');
        if (mEl) mEl.textContent = String(mins).padStart(2, '0');
        if (sEl) sEl.textContent = String(secs).padStart(2, '0');
        if (diff <= 0) clearInterval(timer);
      }
      tick();
      timer = setInterval(tick, 1000);
    });
  }
  function initReveal() {
    const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (!('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
    );
    els.forEach((el) => io.observe(el));
  }
  function initStickyCta() {
    const bar = document.getElementById('wn-sticky-cta');
    const trigger = document.querySelector<HTMLElement>('.wn-hero-bar .btn-primary');
    if (!bar || !trigger || !('IntersectionObserver' in window)) return;
    const io = new IntersectionObserver(([entry]) => bar.classList.toggle('is-visible', !entry.isIntersecting), { threshold: 0 });
    io.observe(trigger);
  }
  function initParallax() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
    if (!layers.length) return;
    let ticking = false;
    function update() {
      const vh = window.innerHeight || 1;
      layers.forEach((el) => {
        const rect = el.getBoundingClientRect();
        const center = rect.top + rect.height / 2;
        const progress = (center - vh / 2) / vh;
        const speed = parseFloat(el.dataset.parallax ?? '10');
        const scale = el.dataset.parallaxScale ? parseFloat(el.dataset.parallaxScale) : 1;
        el.style.transform = `translateY(${progress * speed}%)${scale !== 1 ? ` scale(${scale})` : ''}`;
      });
      ticking = false;
    }
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }
  initCountdowns();
  initReveal();
  initStickyCta();
  initParallax();
</script>

<style>
  /* AI Woman Nights: eigene warme Magenta→Gold-Palette statt Magenta/Blau/Violett,
     rundere Formen, editorialere Typografie — bewusst abgesetzt von den normalen
     AI Nights Event-Seiten. */
  .wn {
    --wn-gradient: linear-gradient(120deg, #ff4f9c 0%, #ffcf5c 100%);
    --wn-gold: #ffcf5c;
    --wn-surface: linear-gradient(135deg, rgba(255, 79, 156, 0.14), rgba(255, 207, 92, 0.1)), rgba(255, 255, 255, 0.045);
    --wn-surface-border: rgba(255, 121, 172, 0.32);
  }

  /* Hero: volles Eventbild als Hintergrund (wie bei den normalen AI Nights),
